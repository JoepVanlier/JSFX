@init
function calc_smooth_coeff(cutoff)
instance()
global(srate)
local(g)
( 
  g = tan($pi * cutoff / srate);
  g /(1 + g)
);

function smooth(target)
global(smooth_coeff)
local(y, v)
instance(s)
(
  v = smooth_coeff * (target - s);
  y = v + s;
  s = y + v;
  y
);

function init_butter2(f0)
global(srate)
local(g)
instance(
  <?k = 1; loop(2, printf("k_%d, a1_%d, a2_%d, a3_%d, ", k, k, k, k); k += 1);?>
)
(
  g = tan($pi * f0 / srate);
  
  k_1 = 1.84775906552; // 1 / Q
  k_2 = 0.76536684415;

  <?
    k = 1;
    loop(2,
      printf("a1_%d = 1 / (1 + g * (g + k_%d));", k, k);
      printf("a2_%d = g * a1_%d;", k, k);
      printf("a3_%d = g * a2_%d;", k, k);
      k += 1;
    );
  ?>
);

function eval_butter2(v0)
global()
local(v1, v2, v3)
instance(
  <?k = 1; loop(2, printf("ic1eq_%d, ic2eq_%d, k_%d, a1_%d, a2_%d, a3_%d, ", k, k, k, k, k, k); k += 1);?>
)
(
  <?
    k = 1;
    loop(2,
      printf("v3 = v0 - ic2eq_%d;", k);
      printf("v1 = a1_%d * ic1eq_%d + a2_%d * v3;", k, k, k);
      printf("v2 = ic2eq_%d + a2_%d * ic1eq_%d + a3_%d * v3;", k, k, k, k);
      printf("ic1eq_%d = v1 + v1 - ic1eq_%d;", k, k);
      printf("ic2eq_%d = v2 + v2 - ic2eq_%d;", k, k);
      printf("v0 = v0 - k_%d * v1 - v2;", k);
    
      k += 1;
    );
  ?>
);


function eval_butter2_2(v0)
global()
local(v1, v2, v3)
instance(
  <?k = 1; loop(2, printf("ic3eq_%d, ic4eq_%d, k_%d, a1_%d, a2_%d, a3_%d, ", k, k, k, k, k, k); k += 1);?>
)
(
  <?
    k = 1;
    loop(2,
      printf("v3 = v0 - ic4eq_%d;", k);
      printf("v1 = a1_%d * ic3eq_%d + a2_%d * v3;", k, k, k);
      printf("v2 = ic4eq_%d + a2_%d * ic3eq_%d + a3_%d * v3;", k, k, k, k);
      printf("ic3eq_%d = v1 + v1 - ic3eq_%d;", k, k);
      printf("ic4eq_%d = v2 + v2 - ic4eq_%d;", k, k);
      printf("v0 = v0 - k_%d * v1 - v2;", k);
    
      k += 1;
    );
  ?>
);

function _init_spreader_buffer(freemem, in_buffer_size, window_in)
instance(buf, p0, p2, buffer_size, half_buffer, window)
global()
local()
(
  buffer_size = in_buffer_size;
  half_buffer = in_buffer_size / 2;
  window = window_in;
  p0 = 0;
  p2 = floor(rand() * (buffer_size - 1));
  buf = freemem;
  
  buf + buffer_size
);

function spreader_update_parameters(spread_slider, mix)
local(detune_fade, detuned_gain, spread)
global()
instance(
  <?i=0; loop(12, printf("shifter%d, ", i); i += 1;)?>
  dry_gain, total_gain, spread_gain,
)
(
  // Wrangle input parameters
  detune_fade = min(10.0 * spread_slider, 1.0);
  detuned_gain = (mix >= 100.0) ? 1.0 : 0.01 * mix;
  dry_gain = (mix <= 100.0) ? 1.0 : (detune_fade < 1.0) ? max(0.5 * (1.0 - detune_fade), (200.0 - mix) / 100.0) : (200.0 - mix) / 100.0;
  spread_gain = detuned_gain * detune_fade;
  total_gain = (spread_gain == 0.0) ? 1.0 : (1.41 / (1.0 + 2.4494897427831780981972840747059 * spread_gain));
  spread = 0.5 * spread_slider * spread_slider;
  
  // Set individual pitch shifter pitches
  shifter0.out_delta = pow(0.893, spread);
  shifter1.out_delta = pow(0.939, spread);
  shifter2.out_delta = pow(0.98, spread);
  shifter3.out_delta = pow(1.02, spread);
  shifter4.out_delta = pow(1.064, spread);
  shifter5.out_delta = pow(1.11, spread);
  
  shifter6.out_delta = pow(1.0 / 0.893, spread);
  shifter7.out_delta = pow(1.0 / 0.939, spread);
  shifter8.out_delta = pow(1.0 / 0.98, spread);
  shifter9.out_delta = pow(1.0 / 1.02, spread);
  shifter10.out_delta = pow(1.0 / 1.064, spread);
  shifter11.out_delta = pow(1.0 / 1.11, spread);
);

function _spreadshifter_tick(data)
instance(buf, p0, p2)
global()
local(p1i, p1f, p2i, x3, x3a, x3b, x4, x4a, x4b, fade34)
instance(out_delta, test, buffer_size, half_buffer, window)
(
  p0 -= 1;
  (p0 < 0) ? ( p0 += buffer_size; );
  buf[p0] = data;

  p2 -= out_delta;
  (p2 < 0) ? ( p2 += buffer_size; );

  p1i = floor(p2);
  p1f = p2 - p1i;
  x3a = buf[p1i];
  
  p1i += 1;
  (p1i >= buffer_size) ? ( p1i -= buffer_size; );

  x3b = buf[p1i];
  x3 = x3a + p1f * (x3b - x3a);
  
  p2i = (p1i + half_buffer);
  (p2i >= buffer_size) ? ( p2i -= buffer_size; );
  x4a = buf[p2i];
  
  p2i += 1;
  (p2i >= buffer_size) ? ( p2i -= buffer_size; );

  x4b = buf[p2i];
  x4 = x4a + p1f * (x4b - x4a);

  p2i = (p1i - p0);
  (p2i < 0) ? ( p2i += buffer_size; );
  
  fade34 = window[p2i];
  
  x4 + fade34 * (x3 - x4)
);

function init_follower(atk, release)
local()
instance(at, rt, LPF)
global(srate)
(
  at = ( atk > 0 ) ? exp(-1.0/(.0005 * atk * srate)) : 0;
  rt = exp(-1.0/(.0005 * release * srate));
);

function eval_follower(x)
local()
instance(state, at, rt, x)
global()
(
  x > state ? (
    state = at * state + ( 1.0 - at ) * x;
  ) : (
    state = rt * state + ( 1.0 - rt ) * x;
  );
  
  state
);

function spreader_tick(inL, inR, reconstruct_envelope, reset_env)
global()
local(delayed_in, total_out, avg, side)
instance(
  window,
  buffer_size, half_buffer,
  delayL, delayR, delay_ix, read_ix, read_ix2, outL, outR,
  <?i=0; loop(12, printf("shifter%d, ", i); i += 1;)?>
  dry_gain, total_gain, spread_gain,
  env_follower, env_follower2, env_correction, follower_state, zero_time, smooth_total_gain, smooth_total_gain.smooth,
  filt,
)
(
  // Delay the main signal
  delayL[delay_ix] = inL;
  delayR[delay_ix] = inR;
  delay_ix += 1;
  (delay_ix >= buffer_size) ? delay_ix -= buffer_size;
  read_ix = delay_ix - half_buffer;
  (read_ix < 0) ? ( read_ix += buffer_size; );
  
  // Process the chorus
  outL = outR = 0;
  <?i = 0; loop(6, printf("outL += shifter%d._spreadshifter_tick(inL);", i); i += 1; );?>
  <?i = 6; loop(6, printf("outR += shifter%d._spreadshifter_tick(inR);", i); i += 1; );?>
  
  (reconstruct_envelope == 1) ? (
    read_ix2 = read_ix - 1;
    (read_ix2 < 0) ? ( read_ix2 += buffer_size; );
    delayed_in = max(abs(delayL[read_ix] - delayL[read_ix2]), abs(delayR[read_ix] - delayR[read_ix2]));
    total_out = follower_state * max(abs(outL), abs(outR));
    follower_state = env_follower2.eval_follower(env_follower.eval_follower((total_out + delayed_in) > 0.001) > 0.2);
    env_correction = follower_state;
  ) : (reconstruct_envelope == 2) ? (
    reset_env ? (
      zero_time = 1024;
    );
    (zero_time > 0) ? (
      env_correction = window[zero_time];
      zero_time -= 1;
    ) : (
      env_correction += 0.01 * (1.0 - env_correction);
    );
  ) : (
    env_correction = 1;
  );
  
  smooth_total_gain = smooth_total_gain.smooth(total_gain);

  outL = filt.eval_butter2(outL);
  outR = filt.eval_butter2_2(outR);

  outL = (dry_gain * delayL[read_ix] + outL * spread_gain * env_correction) * smooth_total_gain;
  outR = (dry_gain * delayR[read_ix] + outR * spread_gain * env_correction) * smooth_total_gain;
);

function init_spreader(freemem, _buffer_size)
local(i)
global()
instance(
  <?i=0; loop(12, printf("shifter%d, ", i); i += 1;)?>
  delayL, delayR, buffer_size, half_buffer, delay_ix, window, env_follower, env_follower2,
)
(
  buffer_size = _buffer_size;
  half_buffer = _buffer_size / 2;
  freemem = (window = freemem) + buffer_size;
  i = 0;
  loop(buffer_size,
    window[i] = 0.5 - 0.5 * cos(2.0 * $PI * i / buffer_size);
    i += 1;
  );

  freemem = (delayL = freemem) + buffer_size;
  freemem = (delayR = freemem) + buffer_size;
  
  delay_ix = 0;
  
  <?
    i = 0;
    loop(12,
      printf("freemem = shifter%d._init_spreader_buffer(freemem, buffer_size, window);", i);
      i += 1;
    );
  ?>
  
  env_follower.init_follower(0, 50);
  env_follower2.init_follower(1, 50);
  
  freemem
);

function add_sample_mono(sample)
local()
global()
instance(buffer, write_ptr, buffer_end)
(
  write_ptr[] = sample;
  write_ptr += 1;
  (write_ptr == buffer_end) ? write_ptr = buffer;
);

function reset_buffer_mono()
instance(buffer, buffer_end)
global()
local()
(
  memset(buffer, 0, buffer_end - buffer);
);

function hermite_buffer_mono(offset)
local(c0, c1, c2, c3, read_ptr, frac, xm1, x1, x2, xm2, x0)
instance(buffer, buffer_end, write_ptr)
global()
(
  read_ptr = write_ptr - offset;
  
  frac = read_ptr - (read_ptr|0);
  read_ptr = read_ptr|0;
  
  read_ptr < buffer ? read_ptr += buffer_end - buffer;
 
  // If the read buffer is at the start of the buffer, take the last sample instead.
  xm1 = (read_ptr == buffer) ? buffer_end[-1] : read_ptr[-1];
  
  // This one should always be safe since we wrapped.
  x0 = read_ptr[];
  
  ((read_ptr + 2) < buffer_end) ? (
    // Fast path (we're always safe).
    x1 = read_ptr[1];
    x2 = read_ptr[2];
  ) : (
    // Slow path
    read_ptr += 1; (read_ptr == buffer_end) ? read_ptr = buffer;
    x1 = read_ptr[];
    read_ptr += 1; (read_ptr == buffer_end) ? read_ptr = buffer;
    x2 = read_ptr[];
  );

  c0 = x0;
  c1 = 0.5 * (x1 - xm1);
  c2 = xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2;
  c3 = 1.5 * (x0 - x1) + 0.5 * (x2 - xm1);
  ((c3 * frac + c2) * frac + c1) * frac + c0 
);

function block_spinner()
local()
global(srate)
instance(twopisrate, smul)
(
  // v_sound = 343 meter / second
  // mul = 1 / 343 second / meter
  // smul = srate / 343 samples / second
  smul = srate / 343.0;
  twopisrate = 1.0 / srate;
);

function lerp_buffer_mono(freemem, size)
local()
instance(buffer, buffer_end, write_ptr)
global()
(
  buffer = freemem;
  (write_ptr < buffer) ? write_ptr = buffer;
  buffer_end = buffer + size
);

function circ_buffer_mono(freemem, size)
local()
instance(buffer, buffer_end, write_ptr, mask)
global()
(
  buffer = freemem;
  write_ptr = 0;
  mask = size - 1;
  buffer_end = buffer + size
);

function verify_buffer_blank()
local(ptr, ERROR)
global()
instance(buffer, buffer_end)
(
  ERROR = 0;
  ptr = buffer;
  loop(buffer_end - buffer,
    (ptr[] > 0) ? (ERROR = 1;);
    ptr +=1;
  );
  
  ERROR
);

function init_spinner(freemem)
instance(buffer_left, buffer_right)
global()
(
  freemem = buffer_left.lerp_buffer_mono(freemem, 8192);
  freemem = buffer_right.lerp_buffer_mono(freemem, 8192);
  this.block_spinner();
  
  freemem
);

function reset_spinner()
instance(buffer_left, buffer_right)
global()
local()
(
  buffer_left.reset_buffer_mono();
  buffer_right.reset_buffer_mono();
);

TWO_PI = 2.0 * $pi;

function eval_spinner(s0, s1, spin_frequency, radius)
local(left_distance, right_distance, dxl, dxr, dyl, dyr, x, y)
instance(buffer_left, buffer_right, smul, twopisrate, theta, outl, outr, c_radius)
global(TWO_PI, fatal)
(
  buffer_left.add_sample_mono(s0);
  buffer_right.add_sample_mono(s1);
  
  (c_radius == 0) ? c_radius = radius;
  c_radius = 0.9995 * c_radius + 0.0005 * radius;

  theta += spin_frequency * twopisrate;
  (theta > TWO_PI) ? theta -= TWO_PI;
  
  x = c_radius * sin(theta);
  y = c_radius * cos(theta);
  
  dxl = x + 0.2;
  dxr = x - 0.2;
  dyl = y - 0.1;
  dyr = y - 0.1;
  
  left_distance = smul * sqrt(dxl * dxl + dyl * dyl); 
  right_distance = smul * sqrt(dxr * dxr + dyr * dyr);
  
  outl = buffer_left.hermite_buffer_mono(left_distance + 1);
  outr = buffer_right.hermite_buffer_mono(right_distance + 1);
);

function init_simple_diffuser(freemem)
local(drift_update_time_seconds, circ_buffer_size)
instance(
  drift, drift_target, drift_counter, drift_update_samples, drift_amount
  buf_dA1, buf_dA2, buf_dA3, buf_dA4, buf_dB1, buf_dB2l, buf_dB2r,
  delayA1, delayA2, delayA3, delayA4, delayB1, delayB2_left, delayB2_right,
)
global(srate)
(
  circ_buffer_size = 8192;
  drift = 0;
  drift_target = 0;
  
  drift_counter = 0;
  drift_update_time_seconds = 0.2;
  drift_update_samples = drift_update_time_seconds * srate;
  drift_amount = 0.60 / 1000 * srate;
  
  // Fixed sample delay lines (don't need interpolation / no loss)
  delayA3 = floor(3.6 / 1000 * srate);
  delayA4 = floor(12.7 / 1000 * srate);
  delayB1 = floor(7.1 / 1000 * srate);
  
  delayA1 = floor(15.3 / 1000 * srate);
  delayA2 = floor(12.1 / 1000 * srate); // Set to 72.1 for delay-like
  
  // Decorrelation (hermite ahoy :D)
  delayB2_left = floor(9.3 / 1000 * srate);
  delayB2_right = floor(9.731 / 1000 * srate);
  
  freemem = buf_dA1.circ_buffer_mono(freemem, circ_buffer_size);  // A1
  freemem = buf_dA2.circ_buffer_mono(freemem, circ_buffer_size * 4);  // A2
  
  freemem = buf_dA3.circ_buffer_mono(freemem, circ_buffer_size);  // A3
  freemem = buf_dA4.circ_buffer_mono(freemem, circ_buffer_size);  // A4
  
  freemem = buf_dB1.circ_buffer_mono(freemem, circ_buffer_size);  // B1
  
  freemem = buf_dB2l.circ_buffer_mono(freemem, circ_buffer_size);  // B2  left
  freemem = buf_dB2r.circ_buffer_mono(freemem, circ_buffer_size);  // B2  right
);

function init_harmonizer(freemem)
local()
instance(pitch_sampling, pitch_sampling2, circ_buffer, half_buffer, harm_offset, harm_offset2)
global(srate)
(
  circ_buffer = 4096;
  freemem = pitch_sampling.circ_buffer_mono(freemem, circ_buffer);
  freemem = pitch_sampling2.circ_buffer_mono(freemem, circ_buffer);
  
  harm_offset = 0;
  harm_offset2 = circ_buffer * 0.25;
  
  freemem
);

// Hermite
function mask_interpolator(offset)
local(
  c1, c2, c3,
  read_pos,
  read_idx,
  frac,
  xm1, x0, x1, x2
  _mask,
)
instance(buffer, write_ptr, mask)
global()
(
  _mask = mask;
  
  // Read position relative to current write position
  read_pos = write_ptr - offset;

  read_idx = read_pos|0;
  frac = read_pos - read_idx;

  // Wrap indices
  xm1 = buffer[(read_idx - 1) & _mask];
  x0  = buffer[ read_idx      & _mask];
  x1  = buffer[(read_idx + 1) & _mask];
  x2  = buffer[(read_idx + 2) & _mask];

  // 4-point Hermite interpolation
  c1 = 0.5 * (x1 - xm1);
  c2 = xm1 - 2.5*x0 + 2*x1 - 0.5*x2;
  c3 = 1.5*(x0 - x1) + 0.5*(x2 - xm1);

  ((c3 * frac + c2) * frac + c1) * frac + x0;
);

// Quadratic (cheaper)
function mask_interpolator(offset)
local(
  read_pos,
  read_idx,
  frac,
  xm1, x0, x1,
  a, b, c
)
instance(buffer, write_ptr, mask)
(
  read_pos = write_ptr - offset;

  read_idx = read_pos|0;
  frac = read_pos - read_idx;

  xm1 = buffer[(read_idx - 1) & mask];
  x0  = buffer[ read_idx      & mask];
  x1  = buffer[(read_idx + 1) & mask];

  // 3-point Lagrange
  a = 0.5 * frac * (frac - 1);
  b = -(frac + 1) * (frac - 1);
  c = 0.5 * frac * (frac + 1);

  xm1*a + x0*b + x1*c;
);

<?
  function print_reader(buffer_name, offset_variable)
  (
      printf("%s.buffer[(%s.write_ptr - %s) & %s.mask]", buffer_name, buffer_name, offset_variable, buffer_name);
  );
?>

<?
  function store_sample(buffer_name, sample_name)
  (
      printf("%s.buffer[%s.write_ptr] = %s;", buffer_name, buffer_name, sample_name);
      printf("%s.write_ptr = (%s.write_ptr + 1) & %s.mask;", buffer_name, buffer_name, buffer_name);
  );
?>

function add_sample_mono(sample)
local()
global()
instance(buffer, write_ptr, buffer_end)
(
  write_ptr[] = sample;
  write_ptr += 1;
  (write_ptr == buffer_end) ? write_ptr = buffer;
);

function update_diffuser_params(semitones, density, drift, delay)
local()
global(srate)
instance(playhead_speed, high_density, drift_level, playhead_speed2, delayA2, harm_offset, harm_offset2, circ_buffer)
(
  density ? (
    playhead_speed = 1 - pow(2, max(-1000, semitones - 0.02) / 12);
    playhead_speed2 = 1 - pow(2, max(-1000, semitones + 0.02) / 12);
    
    (high_density != density) ? (
      harm_offset2 = harm_offset + circ_buffer * 0.24;
      (harm_offset2 < 0) ? harm_offset2 = circ_buffer;
      (harm_offset2 > circ_buffer) ? harm_offset2 = 0;
    );
  ) : (
    playhead_speed = 1 - pow(2, max(-1000, semitones) / 12);
  );
  high_density = density;
  delayA2 = floor(12.1 * exp(log(160/12.1) * delay) / 1000 * srate);
  drift_level = drift;
);

function eval_simple_diffuser(s0)
local(
  r,
  k1, k2, k3,
  A_s,
  delayed,
  A_d1, A_d2, A_d3, A_d4, y, gain, phase,
  pitch_drift,
)
instance(
  drift, drift_target, drift_counter, drift_update_samples, drift_amount, drift_level,
  
  buf_dA1, buf_dA2, buf_dA3, buf_dA4, buf_dB1, buf_dB2l, buf_dB2r,
  delayA1, delayA2, delayA3, delayA4, delayB1, delayB2_left, delayB2_right,
  
  out_left, out_right,
  
  pitch_sampling, pitch_sampling2,
  harm_offset, harm_offset2, circ_buffer, buf_center, playhead_speed, playhead_speed2, high_density, ddrift,
)
global()
(
  //////////////////////
  // DIFFUSION STAGE
  //////////////////////
  
  // Nested allpass
  A_d1 = <?print_reader("buf_dA1", "delayA1")?>;
  A_d2 = <?print_reader("buf_dA2", "delayA2")?>;
   
  k1 = 0.5;
  k2 = 0.3;
  y = A_d2 - k2 * A_d1 - k1 * s0;
  <?store_sample("buf_dA1", "s0 + k1 * y")?>
  <?store_sample("buf_dA2", "A_d1 + k2 * (A_d2 - k2 * A_d1)")?>

  <?store_sample("pitch_sampling2", "y")?>

  // Simple allpass
  k3 = 0.85;
  delayed = <?print_reader("buf_dB1", "delayB1")?>;
  A_s = y - k3 * delayed;
  <?store_sample("buf_dB1", "A_s")?>
  y = k3 * A_s + delayed;

  //////////////////////
  // DIFFUSION STAGE
  //////////////////////
  A_d3 = <?print_reader("buf_dA3", "delayA3")?>;
  A_d4 = <?print_reader("buf_dA4", "delayA4")?>;
  
  s0 = y;
  k1 = 0.5;
  k2 = 0.3;
  y = A_d3 - k2 * A_d4 - k1 * s0;
  <?store_sample("buf_dA3", "s0 + k1 * y")?>
  <?store_sample("buf_dA4", "A_d3 + k2 * (A_d4 - k2 * A_d3)")?>

  //////////////////////
  // HARMONIZER
  //////////////////////
  pitch_drift = drift * drift_level;
  harm_offset += playhead_speed;
  (harm_offset < 0) ? harm_offset = circ_buffer;
  
  (harm_offset > circ_buffer) ? harm_offset = 0;
  buf_center = circ_buffer / 2;
  
  phase = 1.0 - abs(harm_offset - buf_center) / buf_center;
  gain = phase * phase * (3.0 - 2.0 * phase);
 
  <?store_sample("pitch_sampling", "y")?>
  y = pitch_sampling.mask_interpolator(harm_offset) * sqrt(gain);
  y += pitch_sampling2.mask_interpolator(harm_offset + buf_center + (1 - gain) * pitch_drift) * sqrt(1 - gain);
  
  high_density ? (
    harm_offset2 += playhead_speed2;
    (harm_offset2 < 0) ? harm_offset2 = circ_buffer;
    (harm_offset2 > circ_buffer) ? harm_offset2 = 0;
    
    phase = 1.0 - abs(harm_offset2 - buf_center) / buf_center;
    gain = phase * phase * (3.0 - 2.0 * phase);
    y += pitch_sampling2.mask_interpolator(harm_offset2) * sqrt(gain);
    y += pitch_sampling.mask_interpolator(harm_offset2 + buf_center - (1 - gain) * pitch_drift) * sqrt(1 - gain);
    y *= 0.6;
  );
  
  //////////////////////
  // STEREOIZE OUTPUT
  //////////////////////
  drift_counter += 1;
  (drift_counter >= drift_update_samples) ?
  (
    drift_counter = 0;
    r = rand(1);
    drift_target = (r + r - 1) * drift_amount;
    ddrift = (drift_target - drift) / drift_update_samples
  );

  drift += ddrift;

  k3 = 0.5;
  delayed = buf_dB2l.mask_interpolator(delayB2_left + drift);
  //delayed = <?print_reader("buf_dB2l", "delayB2_left")?>;
  A_s = y - k3 * delayed;
  <?store_sample("buf_dB2l", "A_s")?>
  out_left = k3 * A_s + delayed;

  delayed = buf_dB2r.mask_interpolator(delayB2_right + drift);
  //delayed = <?print_reader("buf_dB2r", "delayB2_right")?>;
  A_s = y - k3 * delayed;
  <?store_sample("buf_dB2r", "A_s")?>
  out_right = k3 * A_s + delayed;
);

