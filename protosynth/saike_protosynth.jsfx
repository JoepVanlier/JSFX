// sprintf(9, \"%%\.1f\", f%d_morph)
function morph_level(morph)
(
  (morph < 0.2) ? (
    "LP"
  ) : ( morph < 0.4 ) ? (
    "BP"
  ) : ( morph < 0.6 ) ? (
    "HP"
  ) : ( morph < 0.8 ) ? (
    "BR"
  ) : (
    "LP"
  )
);

