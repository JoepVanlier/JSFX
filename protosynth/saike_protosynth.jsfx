ap_feedback_slider1.check_text_input(<?printf("%d", uuid(););?>) ? ( slider(ap_feedback_slider1.sl) = max(ap_feedback_slider1.sl_min, min(ap_feedback_slider1.sl_max, text_box.result / 100)); );

ap_sat_slider1.active = allpass;
