spreader_mix.check_text_input_defaults();

spreader_detune.active = spreader_active;
spreader_detune.rounding_increment = 0.01;
spreader_detune.slider_ui(<?printf("%d", uuid(););?>, fx_origin + hw + 1, cy, hw, 8, sprintf(1, "%d%%", 100 * spread_slider), "Spreader Detune", "Sp Detune");
spreader_detune.check_text_input(<?printf("%d", uuid(););?>) ? ( slider(spreader_detune.sl) = max(spreader_detune.sl_min, min(spreader_detune.sl_max, text_box.result / 100)); );

cy += 10;
allpass_toggle.simple_serialize_toggle(fx_origin, cy + 1, toggle_size, allpass, "Enable Smear\n\nEnable allpass stack that\nsmears the audio.", "Smear") ? (
  allpass = 1 - allpass;
);

dark_font = light_theme;
txt_blit("SMEAR", fx_origin + 8, cy + 2);
dark_font = 0;

allpass ? (
  tracking_toggle.simple_serialize_toggle(fx_origin + 73, cy + 1, toggle_size, smear_tracking, "Track key.", "Keytrack") ? (
    smear_tracking = 1 - smear_tracking;
  );
);

cy += 8;
ap_freq_slider1.active = allpass;
ap_freq_slider1.rounding_increment = 1337;
ap_freq_slider1.slider_ui(<?printf("%d", uuid(););?>, fx_origin, cy, fx_width + 1, 8, sprintf(1, "%d", ap_freq), "Allpass Frequency", "AP Freq");
