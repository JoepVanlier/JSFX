fx_width = 80;
cy = 1;

fx_origin = img_w - fx_width - side_pad;
verb_enable_toggle.simple_serialize_toggle(fx_origin, cy + 1, toggle_size, verb_enabled, "Enable Reverb", "Enable Verb") ? (
  verb_enabled = 1 - verb_enabled;
);

dark_font = light_theme;
txt_blit("VERB", fx_origin + 8, cy + 2);
dark_font = 0;

fb_toggle.simple_serialize_toggle(fx_origin + 38, cy + 1, toggle_size, 1 - low_feedback, "Metallic\n\nAllows longer ringing, but sounds more metallic", "Metallic") ? (
  low_feedback = 1 - low_feedback;
);

reverb_algo1.simple_serialize_toggle(fx_origin + 53, cy + 1, toggle_size, reverb_algorithm == 0, "Sparse Verb", "Sparse") ? (
  reverb_algorithm = 0;
);

reverb_algo2.simple_serialize_toggle(fx_origin + 60, cy + 1, toggle_size, reverb_algorithm == 1, "Dense Verb", "Dense") ? (
  reverb_algorithm = 1;
);

reverb_algo3.simple_serialize_toggle(fx_origin + 67, cy + 1, toggle_size, reverb_algorithm == 2, "Diffuse Delay", "Delay") ? (
