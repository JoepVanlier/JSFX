function node(x, y, w, h, text, text_offset)
instance(_x, _y, _w, _h, x_from, x_to, y_from, y_to, over, smooth_highlight)
local(mouse_nx, mouse_ny)
global(x_offset, y_offset, blit_scale, mouse_cap, gfx_x, gfx_y, mouse_x, mouse_y, cap_mode, bigger_font, gfx_a, grid_color, dark_font, light_theme)
(
  colormodel(grid_color);
  alpha_level(smooth_highlight);
  
  _x = x; _y = y; _w = w; _h = h;
  gfx_line(x + 1, y, x + w - 2, y);
  gfx_line(x + w - 1, y, x + w - 1, y + h - 1);
  gfx_line(x, y, x, y + h - 1);
  gfx_line(x + 1, y + h - 1, x + w - 2, y + h - 1);
  x_from = x + w;
  y_from = y + 0.5 * h;
  x_to = x - 1;
  y_to = y + 0.5 * h;
  
  mouse_nx = (mouse_x - x_offset) / blit_scale;
  mouse_ny = (mouse_y - y_offset) / blit_scale;
  over = ((mouse_nx > x) && (mouse_nx < (x + w)) && (mouse_ny > y) && (mouse_ny < (y + w)) && (cap_mode == 0));
  this.update_smooth_highlight(over);
  
  
  text ? (
    dark_font = light_theme;
    txt_blit(text, x + text_offset + 0.5 * bigger_font, y + 2);
    dark_font = 0;
  );
);

function mix_node(x, y, w, h, slider_idx)
instance()
local(value, text, mouse_nx, mouse_ny, over, ix)
global(gfx_a, gfx_x, gfx_y, mouse_x, mouse_y, x_offset, y_offset, blit_scale, cap_mode, last_cap, mouse_cap)
(
  value = slider(slider_idx);
  text = (value == 0) ? "ADD"
  : (value == 1) ? "AMP"
  : (value == 2) ? "MUL"
  : (value == 3) ? "XOR"
  : (value == 4) ? "XOD"
  : (value == 5) ? "CON"
  : (value == 6) ? "FrS"
  : (value == 7) ? "PM1"
  : (value == 8) ? "PM2"
  : (value == 9) ? "PM3";
  this.node(x, y, w, h, text, 2);

  mouse_nx = (mouse_x - x_offset) / blit_scale;
  mouse_ny = (mouse_y - y_offset) / blit_scale;
  over = ((mouse_nx > x) && (mouse_nx < (x + w)) && (mouse_ny > y) && (mouse_ny < (y + w)) && (cap_mode == 0));

  ((last_cap == 0) && over) ? (
    (mouse_cap == 2) ? (
      gfx_x = mouse_x;
      gfx_y = mouse_y;
      ix = gfx_showmenu("Additive mixing|Amplitude modulation|Ring modulation (multiply signals)|XOR|XOR on diff|Convolve|Freq Shift|Phase Mod|Phase Mod Abs|Phase Mod Abs2");
      (ix > 0) ? (
        slider(slider_idx) = ix - 1;
      );
    );
  );
  
  
);

function cline(x1, y1, x2, y2)
(
  gfx_a = 0.5;
  gfx_line(floor(x1), floor(y1) - 0.5, floor(x2), floor(y2) - 0.5, 1);
  gfx_line(floor(x1), floor(y1), floor(x2), floor(y2), 0);
  gfx_line(floor(x1), floor(y1) + 0.5, floor(x2), floor(y2) + 0.5, 1);
);

block_size = 8;
spacing = 10;
left_side = 10;
start = cy;
cx = left_side;
cy = start;

over_filter = 0;
over_osc = 0;

mnode = 1;

function active_color(enabled, solo)
(
  any_solo ? (
    solo ? (
      gfx_set(0.4, 1.0, 0.4, 0.5);
      gfx_rect(cx, cy, block_size, block_size);
    ) : (
      gfx_set(0.0, 0.0, 0.0, 0.6);
      gfx_rect(cx, cy, block_size, block_size);
      gfx_set(0.1, 0.1, 0.1, 1.0);
      enabled ? gfx_rect(cx, cy, block_size, block_size);
    );
  ) : (
    gfx_set(0.2, 0.2, 0.3, 1.0);
    colormodel(grid_color);
    enabled ? gfx_rect(cx, cy, block_size, block_size);
  );
);

<?
