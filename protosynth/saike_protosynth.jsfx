  reverb_algorithm = 3;
);

cy += 8;

time_slider.active = verb_enabled;
hw = fx_width / 2;
time_slider.rounding_increment = 1337;
time_slider.slider_ui(<?printf("%d", uuid(););?>, fx_origin, cy, hw, 8, sprintf(9, "%d", time_ms), "Reverb time in\nmilliseconds", "Verb Time");

verb_mix_slider.active = verb_enabled;
verb_mix_slider.rounding_increment = 0.1;
verb_mix_slider.color = rightpanel_color;
verb_mix_slider.slider_ui(<?printf("%d", uuid(););?>, fx_origin + hw + 1, cy, hw, 8, sprintf(9, "%d", 100 * verb_mix), "Verb mix", "Verb Mix");

cy += 8;
filters.active = verb_enabled;
filters.multi_slider_ui(<?printf("%d", uuid(););?>, fx_origin, cy, fx_width + 1, 8, 20, 22050, 1);
verb_enabled ? (
  _qq1 = <?printf("%d", uuid(););?>; filters.multi_slider_notch_nearest(_qq1, 250);
  _qq2 = <?printf("%d", uuid(););?>; filters.multi_slider_notch_nearest(_qq2, 251);
  _qq3 = <?printf("%d", uuid(););?>; filters.multi_slider_notch_nearest(_qq3, 252);
  _qq4 = <?printf("%d", uuid(););?>; filters.multi_slider_notch_nearest(_qq4, 253);
  colormodel_fill(0.1);
  filters.multi_slider_notch_ui(_qq1, 250, "Side cut frequency", gfx_r, gfx_g, gfx_b, "Verb Side cut");
  filters.multi_slider_notch_ui(_qq4, 253, "Damping factor", gfx_r, gfx_g, gfx_b, "Verb Damping");
  colormodel_fill(0.9);
  filters.multi_slider_notch_ui(_qq2, 251, "Low cut frequency", gfx_r, gfx_g, gfx_b, "Verb Low cut");
  filters.multi_slider_notch_ui(_qq3, 252, "High cut frequency", gfx_r, gfx_g, gfx_b, "Verb High cut");
);

cy += 10;

poisson_toggle.simple_serialize_toggle(fx_origin, cy + 1, toggle_size, poisson_enabled, "Enable Noise", "Enable Noise") ? (
