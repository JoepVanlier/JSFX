(external_os_factor > 4) ? (
  gfx_set(0, 0, 0, 1);
  gfx_rect(0, 0, gfx_w, gfx_h);
  gfx_set(1, 1, 1, 1);
  gfx_printf("WARNING:\n\nThis plugin only supports samplerates up to 192 kHz");
);


(freemem > 32000000) ? (
  gfx_set(0, 0, 0, 1);
  gfx_rect(0, 0, gfx_w, gfx_h);
  gfx_set(1, 1, 1, 1);
  gfx_printf("WARNING:\n\nYou've gone off the deep end with your memory use lad.");
);

handle_dropped_files_microtuning(tuning_memory);

// Reset dropped file status
gfx_getdropfile(-1);

(!active_text_input) ? (
  last_char = char;
);

