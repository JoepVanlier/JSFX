    printf("f_cutoff_slider%d.modulator_field(%d, cx, cy, 8, 1, MODULATOR_STRING, \"F%d Cutoff Env\", 0, %d, 1);\n cx += 8;", i + 1, uuid(), i + 1, N_SELECTABLE_MODULATORS);
