function nuke_midi()
(
  midi.reset_midi();
  <?loop(i=0;MAX_VOICES, printf("v%d.process_midi(i, 0, 0, 0, -1, 0);", i, i); i += 1);?>
);

stereoize_buffer_size = 32766;
stereoize_buffer.init_buffer(freemem, freemem + stereoize_buffer_size);
freemem += stereoize_buffer_size + 2;

freemem = spinner.init_spinner(freemem);
spinner.reset_spinner();

function init_stereoizer()
(
  stereoize_hp.init_linearSVF(0.152, 0);
  left_spin_hp.init_linearSVF(0.152, 0);
  right_spin_hp.init_linearSVF(0.152, 0);
  
  delay_ms = 16.12;
  stereoize_buffer.set_offset(delay_ms * srate / 1000);
);

init_stereoizer();

nuke_midi();
CURRENT_VERSION = 20;
version = CURRENT_VERSION;

@serialize
update_ticker = 0;

write_mode = file_avail(0) < 0;

(!write_mode) ? (
  preset_load = 1337;
  current_gain = 0;
  d_gain = 0;
  <?loop(i2=1;8, printf("memset(wt%d.sample_mem_start, 0, 8 * SAMPLES_PER_WT * WT_LENGTH);", i2); i2 += 1;);?>
);

file_var(0, version);

<?
  loop(i=0;8,
    printf("gain_slider%d.serialize(version);\n", i + 1);
    printf("tune_slider%d.serialize(version);\n", i + 1);
    printf("spacing_slider%d.serialize(version);\n", i + 1);
    printf("brightness_slider%d.serialize(version);\n", i + 1);
    printf("spacing_offset_slider%d.serialize(version);\n", i + 1);
    i += 1;
  );
?>

version <= 3 ? (
  stored_envelopes = 8;
) : (
  stored_envelopes = 6;
);
<?
  loop(i=0;8,
    printf("(%d < stored_envelopes) ? (", i);
    printf("env_attack_slider%d.serialize(version);\n", i + 1);
    printf("env_decay_slider%d.serialize(version);\n", i + 1);
    printf("env_sustain_slider%d.serialize(version);\n", i + 1);
    printf("env_release_slider%d.serialize(version);\n", i + 1);
    printf(");", i);
    i += 1;
  );
?>

<?
  loop(i=1;3,
    printf("f_cutoff_slider%d.serialize(version);\n", i);
    printf("f_reso_slider%d.serialize(version);\n", i);
    printf("f_morph_slider%d.serialize(version);\n", i);
    i += 1;
  );
?>

(version > 2) ? (
  file_var(0, filter1_enabled);
  file_var(0, filter2_enabled);
  file_var(0, filter3_enabled);
) : (
  filter1_enabled = filter2_enabled = filter3_enabled = 0;
);

(version > 3) ? (
  <?
    loop(i=0;N_MODULATORS,
      printf("mod_type_slider%d.serialize(version);\n", i + 1);
      printf("mod_freq_slider%d.serialize(version);\n", i + 1);
      printf("mod_phase_slider%d.serialize(version);\n", i + 1);
      printf("mod_lr_slider%d.serialize(version);\n", i + 1);
      printf("mod_amount_slider%d.serialize(version);\n", i + 1);
      i += 1;
    );
  ?>
) : (
  <?
    loop(i=0;N_MODULATORS,
      printf("mod_type_slider%d.defaults();\n", i + 1);
      printf("mod_freq_slider%d.defaults();\n", i + 1);
      printf("mod_phase_slider%d.defaults();\n", i + 1);
      printf("mod_lr_slider%d.defaults();\n", i + 1);
      printf("mod_amount_slider%d.defaults();\n", i + 1);
      i += 1;
    );
  ?>
);

(version > 4) ? (
  <?
    loop(i=1;N_OSCS,
      printf("file_var(0, osc%d_enabled);", i);
      printf("file_var(0, osc%d_type);", i);
      i += 1;
    );
  ?>
) : (
  <?
    loop(i=1;N_OSCS,
      printf("osc%d_enabled = 1;", i);
      printf("osc%d_type = 0;", i);
      i += 1;
    );
  ?>
);

(version > 5) ? (
  output_slider1.serialize(version);
  chorus_slider1.serialize(version);
  noise_slider1.serialize(version);
) : (
  output_slider1.defaults();
  chorus_slider1.defaults();
  noise_slider1.defaults();
);

(version > 6) ? (
  <?loop(i=1;N_MODULATORS, printf("file_var(0, mod%d_restart);", i); i += 1; );?>
) : (
  <?loop(i=1;N_MODULATORS, printf("mod%d_restart = 0;", i); i += 1; );?>
);

(version > 7) ? (
  file_var(0, filter4_enabled);
) : (
  filter4_enabled = 0;
  f4_cutoff = 1;
);
f_cutoff_slider4.serialize_if(version, 8);
f_reso_slider4.serialize_if(version, 8);
f_morph_slider4.serialize_if(version, 8);

(version > 8) ? (
  file_var(0, verb_enabled);
  file_var(0, poisson_enabled);
) : (
  verb_enabled = 0;
  poisson_enabled = 0;
);

(version > 9) ? (
  file_var(0, glide);
  file_var(0, force_glide);
) : (
  glide = 0;
  force_glide = 0;
  glide_time = 100;
  low_feedback = 0;
  reverb_algorithm = 0;
);

(version > 10) ? (
  file_var(0, low_feedback);
  file_var(0, reverb_algorithm);
) : (
  low_feedback = 0;
  reverb_algorithm = 0;
);

(version < 12) ? (
  fb1 = fb2 = fb3 = fb4 = fb21 = fb22 = fb31 = 0;
);

(version < 13) ? (
  pitchbend_range = 2;
  global_tuning = 0;
);

global_tuning_slider1.serialize_if(version, 13);

(version < 13) ? (
  microtuned = 0;
  has_microtuning = 0;
) : (
  file_var(0, microtuned);
  microtuned ? (
    file_mem(0, tuning_memory, 128);
    has_microtuning = 1;
  );
);

(version < 14) ? (
  <?
    loop(i=0;N_MODULATORS,
      // The default used to be bad
      printf("mod%d_amount = 1.0;\n", i + 1);
      i += 1;
    );
  ?>
);

(version > 14) ? (
  ap_freq_slider1.serialize(version);
  ap_feedback_slider1.serialize(version);
  ap_sat_slider1.serialize(version);
  file_var(0, allpass);
) : (
  ap_freq_slider1.defaults();
  ap_feedback_slider1.defaults();
  ap_sat_slider1.defaults();
  ap_freq = 241;
  ap_feedback = -.206;
  ap_sat = 0.1;
  allpass = 0;
);

(version < 15) ? (
  has_wavetable_data = 0;
  <?loop(i2=1;8, printf("wt%d.serialize_sample(SAMPLES_PER_WT, WT_LENGTH, 0, !write_mode);", i2); i2 += 1;);?>
);

file_var(0, has_wavetable_data);
has_wavetable_data ? (
  <?loop(i2=1;8, printf("wt%d.serialize_sample(SAMPLES_PER_WT, WT_LENGTH, (osc%d_type|0) == 4, !write_mode);", i2, i2); i2 += 1;);?>
);

<?
  loop(i=0;8,
    printf("(%d < stored_envelopes) ? (", i);
    printf("env_amount_slider%d.serialize_if(version, 17);\n", i + 1);
    printf(");", i);
    i += 1;
  );
?>

(version > 17) ? (
  spreader_detune.serialize(version);
  spreader_mix.serialize(version);
  spreader_freq.serialize(version);
  file_var(0, spreader_active);
) : (
  spreader_detune.defaults();
  spreader_mix.defaults();
  spreader_freq.defaults();
  spread_slider = 0.5;
  spread_mix = 100;
  spread_frequency = 20;
  spreader_active = 0;
);

(version > 18) ? (
  file_var(0, smear_tracking);
) : (
  smear_tracking = 0;
);

(version > 19) ? (
  file_var(0, stereoize);
  file_var(0, spinner_frequency);
  file_var(0, spinner_depth);
  
  <?loop(i=1;8, printf("file_var(0, resonator_mode%d);", i); i += 1);?>
  <?loop(i=1;8, printf("file_var(0, out_mode%d);", i); i += 1);?>
) : (
  stereoize = 0;
  spinner_frequency = 2;
  spinner_depth = 0;
  
  <?loop(i=1;8, printf("resonator_mode%d = 0;", i); i += 1);?>
  <?loop(i=1;8, printf("out_mode%d = 0;", i); i += 1);?>
);

update_solo();
version = CURRENT_VERSION;

(preset_load == 1337) ? (
  preset_load = 65;
);

@slider

@block
spinner.block_spinner();

(last_glide != glide) ? (
  // Make sure we reset notes when we switch glide modes (otherwise stuck notes might ensue)
  last_glide = glide;
  nuke_midi();
);

pdc_top_ch = 2;
pdc_bot_ch = 0;
pdc_delay = spreader_active ? spreader.half_buffer : 0;
smooth_coeff = calc_smooth_coeff(1000.0 / 25.0);

must_glide = force_glide && glide;

(reverb_algorithm != last_reverb_algo) ? (
  last_reverb_algo = reverb_algorithm;
  verb.reset_diff_verb();
  fft_verb.reset_fft_verb();
);

shimmer = 0;
drops = 0;
shift_mode = 0;
shift_freq = 0;
fft_verb.stft_reverb_settings(1, time_ms, 0, side_cut_freq, damping_freq, high_cut_freq, low_cut_freq, shimmer, drops, shift_mode, shift_freq);

update_solo();

any_solo ? (
  <?loop(i=0;N_OSCS, printf("osc%d_active = osc%d_solo;", i + 1, i + 1); i += 1;);?>
) : (
  <?loop(i=0;N_OSCS, printf("osc%d_active = osc%d_enabled;", i + 1, i + 1); i += 1;);?>
);

external_os_factor = srate / 44100;
fm_scaling = 133120 * external_os_factor;
fm_offset = 1024 * external_os_factor;
slow_update_srate = SLOW_UPDATE_FACTOR / srate;

sample_rate = srate / SLOW_UPDATE_FACTOR;
to_samples = 0.001 * sample_rate;  // Since times were specified in ms
log001 = log(0.01);
log001tds = log001 / to_samples;

inv_samplesblock = 1 / samplesblock;
df3_gain = (pow(10, 0.05 * f3_drive) - current_f3_gain) * inv_samplesblock;
df4_gain = (pow(10, 0.05 * f4_drive) - current_f4_gain) * inv_samplesblock;
d_gain = (pow(10, 0.05 * output_gain) - current_gain) * inv_samplesblock;

// Reverb related
d_side = (side_cut_freq - side_freq) * inv_samplesblock;
d_lp = (high_cut_freq - lp_freq) * inv_samplesblock;
d_hp = (low_cut_freq - hp_freq) * inv_samplesblock;
d_verb = (verb_mix - current_verb_mix) * inv_samplesblock;

d_ap_freq = (ap_freq - current_ap_freq) * inv_samplesblock;
d_ap_fb = (ap_feedback - current_ap_fb) * inv_samplesblock;
d_ap_sat = (ap_sat - current_ap_sat) * inv_samplesblock;


(last_srate != srate) ? (
  prepare_impulse_globals();
  update_global_parameters();
  init_freq_shift_modulator();
  oversampling = 1;
  last_srate = srate;
  israte = 1.0 / srate;
  tpiT = 2.0 * $pi / srate;
  piT = $pi / srate;
  sampling_ratio = legacy_mode ? 1 : 44100 / srate;
  sampling_factor = oversampling / sampling_ratio;
  isampling_factor = 1 / sampling_factor;
  
  init_stereoizer();
);
//israte_radian = 2.0*$pi*israte;

<?
  loop(i=0;N_OSCS,
    printf("gain_slider%d.text_slider_block();", i + 1);
    printf("tune_slider%d.text_slider_block();", i + 1);
    printf("spacing_slider%d.text_slider_block();", i + 1);
    printf("brightness_slider%d.text_slider_block();", i + 1);
    i += 1;
  );
?>

<?
  loop(i=0;N_ENVELOPES,
    printf("env_attack_slider%d.text_slider_block();", i + 1);
    printf("env_decay_slider%d.text_slider_block();", i + 1);
    printf("env_sustain_slider%d.text_slider_block();", i + 1);
    printf("env_release_slider%d.text_slider_block();", i + 1);
    printf("env_amount_slider%d.text_slider_block();", i + 1);
    i += 1;
  );
?>

<?
  loop(i=0;N_MODULATORS,
    printf("mod_freq_slider%d.text_slider_block();", i + 1);
    printf("mod_phase_slider%d.text_slider_block();", i + 1);
    printf("mod_amount_slider%d.text_slider_block();", i + 1);
    
    /*
    printf("mod_lr_slider%d.text_slider_ui(%d, cx, cy, 5 * toggle_size + 4, 8, sprintf(9, \"%%\.1f\", 100 * mod%d_lr), \"Spread\", \"Spread\"); cx += 5 * toggle_size + 4 + 2;", i + 1, uuid(), i + 1);
    printf("mod_lr_slider%d.check_text_input_defaults();", i + 1);
    
    printf("mod_amount_slider%d.text_slider_ui(%d, cx, cy, 5 * toggle_size + 4, 8, sprintf(9, \"%%\.1f\", 100 * mod%d_amount), \"Amount\", \"Amount\"); cx += 5 * toggle_size + 4 + 2;", i + 1, uuid(), i + 1);
    printf("mod_amount_slider%d.check_text_input_defaults();", i + 1);
    */
    
    i += 1;
  );
?>

<?
  loop(i=0;N_FILTERS,
    printf("f_cutoff_slider%d.text_slider_block();", i + 1);
    printf("f_reso_slider%d.text_slider_block();", i + 1);
    printf("f_morph_slider%d.text_slider_block();", i + 1);
    i += 1;
  );
?>

global_tuning_slider1.text_slider_block();


// Fixes stuck notes
midi.notes_remain ? (
  midi.curSample += 1;
  // Reset if MIDI stuff updated
  midi_input = 1;
  midi.midi_sample(midi_input) ? (
    settings_changed = 1;
  );
);

// Spreader
spreader_active ? (
  dspread_slider = spread_slider - current_spread_slider;
  dspread_mix = spread_mix - current_spread_mix;
  dspread_slider = spread_frequency - current_spread_frequency;
  
  spreader.filt.init_butter2(current_spread_frequency);
  spreader.spreader_update_parameters(current_spread_slider, current_spread_mix);
);

pass_through = 1;
midi.midi_block(pass_through);

@sample
preset_load ? (
  current_gain = 0;
  d_gain = 0;
  
  // Actual prepwork doesn't start until @serialize actually finished
  (preset_load < 1024) ? (
    preset_load -= 1;
    
    //n_update = update_ticker = 0;
    chorus.reset_chorus();
    (preset_load == 64) ? (
      <?
      loop(i=0;MAX_VOICES,
        printf("v%d.update_voice();", i, i);
        
        printf("v%d.mix1.reset_phasemod_mem();", i);
        printf("v%d.mix2.reset_phasemod_mem();", i);
        printf("v%d.mix3.reset_phasemod_mem();", i);
        printf("v%d.mix4.reset_phasemod_mem();", i);
        printf("v%d.mix21.reset_phasemod_mem();", i);
        printf("v%d.mix22.reset_phasemod_mem();", i);
        printf("v%d.mix31.reset_phasemod_mem();", i);
        
        printf("v%d.env1_state = 0;", i);
        printf("v%d.env2_state = 0;", i);
        printf("v%d.env3_state = 0;", i);
        printf("v%d.env4_state = 0;", i);
        printf("v%d.env5_state = 0;", i);
        printf("v%d.env6_state = 0;", i);
        
        i += 1;
      );
      ?>
    
      verb.reset_diff_verb();
      fft_verb.reset_fft_verb();
    );
  );
);

spreader_active ? (
  (d_frequency != 0) ? (
    spreader.filt.init_butter2(current_spread_frequency);
  );
);

function cheapo_block(x)
local(y)
global()
instance(xm1, ym1)
(
  y = x - xm1 + 0.995 * ym1;
  xm1 = x;
  ym1 = y;
  
  y
);

freq_shift_modulator_sample();

midi.curSample += 1;
midi.notes_remain ? (
  // Reset if MIDI stuff updated
  midi_input = 1;
  midi.midi_sample(midi_input) ? (
    settings_changed = 1;
  );
);

m_state = max(0.9999 * m_state, max(midi.notes_on, m_out_last));
audio_running = m_state > 0.00000000001;

audio_running ? (

  big_tick = update_ticker == 0;
  update_ticker += 1;
  (update_ticker > 128) ? (
    update_ticker = 0;
  );
  
  big_tick ? (
    midi.update_notes();
  );
  
  voice_update = (n_update % SLOW_UPDATE_FACTOR) == 0;
  voice_update ? (
    global_tuning_slider1.mod_target1 ? (
      modulator_mem = 
        (latest_voice == 0) ? v0.modulator_mem
        : (latest_voice == 1) ? v1.modulator_mem
        : (latest_voice == 2) ? v2.modulator_mem
        : (latest_voice == 3) ? v3.modulator_mem
        : (latest_voice == 4) ? v4.modulator_mem
        : (latest_voice == 5) ? v5.modulator_mem
        : (latest_voice == 6) ? v6.modulator_mem
        : (latest_voice == 7) ? v7.modulator_mem
        : (latest_voice == 8) ? v8.modulator_mem
        : (latest_voice == 9) ? v9.modulator_mem
        : (latest_voice == 10) ? v10.modulator_mem
        : (latest_voice == 11) ? v11.modulator_mem;
    
      <?get_modulated_value1_preproc_ranged("current_global_tuning", "global_tuning_slider", 1);?>
    ) : (
      current_global_tuning = global_tuning;
    );
  
    pitchbend_modifier = 2 ^ ((pitchbend_range * midi.pitchbend + current_global_tuning) / 12);
    !glide ? (
      <?
      loop(i=0;MAX_VOICES,
        printf("v%d.has_output ? v%d.update_voice();", i, i);
        i += 1;
      );
      ?>
    ) : (
      v0.update_voice();
      k_glide = - log001tds / glide_time;
      v0.update_glide();
    );
  );
  
  (filter4_enabled) ? (
    (voice_update || force_filter4_update) ? (
      modulator_mem = 
        (latest_voice == 0) ? v0.modulator_mem
        : (latest_voice == 1) ? v1.modulator_mem
        : (latest_voice == 2) ? v2.modulator_mem
        : (latest_voice == 3) ? v3.modulator_mem
        : (latest_voice == 4) ? v4.modulator_mem
        : (latest_voice == 5) ? v5.modulator_mem
        : (latest_voice == 6) ? v6.modulator_mem
        : (latest_voice == 7) ? v7.modulator_mem
        : (latest_voice == 8) ? v8.modulator_mem
        : (latest_voice == 9) ? v9.modulator_mem
        : (latest_voice == 10) ? v10.modulator_mem
        : (latest_voice == 11) ? v11.modulator_mem;
  
      keyfollow_mod = 
        (latest_voice == 0) ? v0.keyfollow_mod
        : (latest_voice == 1) ? v1.keyfollow_mod
        : (latest_voice == 2) ? v2.keyfollow_mod
        : (latest_voice == 3) ? v3.keyfollow_mod
        : (latest_voice == 4) ? v4.keyfollow_mod
        : (latest_voice == 5) ? v5.keyfollow_mod
        : (latest_voice == 6) ? v6.keyfollow_mod
        : (latest_voice == 7) ? v7.keyfollow_mod
        : (latest_voice == 8) ? v8.keyfollow_mod
        : (latest_voice == 9) ? v9.keyfollow_mod
        : (latest_voice == 10) ? v10.keyfollow_mod
        : (latest_voice == 11) ? v11.keyfollow_mod;
  
      <?
        get_modulated_value2_preproc_noclamp("f_cutoff", "f_cutoff_slider", 4);
        get_modulated_value2_preproc("f_reso", "f_reso_slider", 4);
        get_modulated_value2_preproc("f_morph", "f_morph_slider", 4);
      ?>
      
      f_cutoff = min(1, max(0, f_cutoff - f4_keyfollow * keyfollow_mod));
      
      current_f4_type = floor(f4_type);
      (current_f4_type == 0) ? (
        this.filter4.lin.init_linear(f_cutoff, f_reso, f_morph);
      ) : (current_f4_type == 1) ? (
        this.filter4.ms20.init_ms20(f_cutoff, f_reso, f_morph);
      ) : (current_f4_type == 2) ? (
        this.filter4.la2.init_lad2(f_cutoff, f_reso, f_morph);
      ) : (current_f4_type == 3) ? (
        this.filter4.la4.init_lad4(f_cutoff, f_reso, f_morph);
      ) : (current_f4_type == 4) ? (
        this.filter4.shriek.init_shriek(f_cutoff, f_reso, f_morph);
      ) : (current_f4_type == 5) ? (
        this.filter4.pl4.init_pl4(f_cutoff, f_reso, f_morph);
      ) : (current_f4_type == 6) ? (
        this.filter4.shriek.init_shriek(f_cutoff, f_reso, f_morph);      
      );
    );
  );
  
  v0.has_output ? v0.play_voice() : (v0.l = v0.r = 0);
  
  !glide ? (
    v1.has_output ? v1.play_voice() : (v1.l = v1.r = 0);
    v2.has_output ? v2.play_voice() : (v2.l = v2.r = 0);
    v3.has_output ? v3.play_voice() : (v3.l = v3.r = 0);
    v4.has_output ? v4.play_voice() : (v4.l = v4.r = 0);
    v5.has_output ? v5.play_voice() : (v5.l = v5.r = 0);
    v6.has_output ? v6.play_voice() : (v6.l = v6.r = 0);
    v7.has_output ? v7.play_voice() : (v7.l = v7.r = 0);
    v8.has_output ? v8.play_voice() : (v8.l = v8.r = 0);
    v9.has_output ? v9.play_voice() : (v9.l = v9.r = 0);
    v10.has_output ? v10.play_voice() : (v10.l = v10.r = 0);
    v11.has_output ? v11.play_voice() : (v11.l = v11.r = 0);
    spl0 += v0.l + v1.l + v2.l + v3.l + v4.l + v5.l + v6.l + v7.l + v8.l + v9.l + v10.l + v11.l;
  ) : (
    spl0 = v0.l;
  );
  
  spl0 = filter4_enabled ? (
    (current_f4_type != last_f4_type) ? (
      last_f4_type = current_f4_type;
      
      current_f4_gain = pow(10, 0.05 * f4_drive);
      df4_gain = 0;
      
      (current_f4_type == 1) ? (
        this.filter4.ms20.reset_ms20();
      ) : (current_f4_type == 2) ? (
        this.filter4.la2.reset_lad2();
      ) : (current_f4_type == 3) ? (
        this.filter4.la4.reset_lad4();
      ) : (current_f4_type == 4) ? (
        this.filter4.shriek.reset_shriek();
      ) : (current_f4_type == 5) ? (
        this.filter4.pl4.reset_pl4();
      ) : (current_f4_type == 6) ? (
        this.filter4.shriek.reset_mj();
      );
      
    ); 
  
    (current_f4_type == 0) ? (
      this.filter4.lin.eval_linear_2p(spl0)
    ) : (current_f4_type == 1) ? (
      this.filter4.ms20.run_ms20(spl0 * current_f4_gain) / current_f4_gain
    ) : (current_f4_type == 2) ? (
      this.filter4.la2.run_lad2(spl0 * current_f4_gain) / current_f4_gain;
    ) : (current_f4_type == 3) ? (
      this.filter4.la4.run_lad4(spl0 * current_f4_gain) / current_f4_gain;
    ) : (current_f4_type == 4) ? (
      this.filter4.shriek.run_shriek(spl0 * current_f4_gain) / current_f4_gain;
    ) : (current_f4_type == 5) ? (
      this.filter4.pl4.run_pl4(spl0 * current_f4_gain) / current_f4_gain;
    ) : (current_f4_type == 6) ? (
      this.filter4.shriek.run_mj(spl0 * current_f4_gain) / current_f4_gain;
    )
  ) : spl0;
  
  
  // Internal engine is still mono
  //spl1 += v0.r + v1.r + v2.r + v3.r + v4.r + v5.r + v6.r + v7.r + v8.r + v9.r + v10.r + v11.r;
  
  stereoize ? (
    stereoize_buffer.update_buffer(spl0);
    stereoize_hp_read = stereoize_buffer.read_buffer();
  
    /* Highpass the added comb filter signal */
    stereoize_hp_read = stereoize_hp.eval_linearSVF_HP6(stereoize_hp_read);
    
    mono_signal_pre_spreader = spl0;
    spl0 = mono_signal_pre_spreader + 0.33 * stereoize_hp_read;
    spl1 = mono_signal_pre_spreader - 0.33 * stereoize_hp_read;
    
    (spinner_depth > 0.01) ? (
      spinner_hp ? (
        spin_spl0_high = left_spin_hp.eval_linearSVF_HP6(spl0);
        spin_spl1_high = right_spin_hp.eval_linearSVF_HP6(spl1);
      ) : (
        spin_spl0_high = spl0;
        spin_spl1_high = spl1;
      );
      
      spinner.eval_spinner(spin_spl0_high, spin_spl1_high, spinner_frequency, spinner_depth);
      
      spl0 += (spinner.outl - spin_spl0_high);
      spl1 += (spinner.outr - spin_spl1_high);
    );
  ) : (
    spl1 = spl0;
  );
  
  chorus.apply_chorus(chorus_amount);
  
  last_gain += d_gain;
  
  n_update += 1;
  
  spl0 = ldc.cheapo_block(spl0);
  spl1 = rdc.cheapo_block(spl1);
  
  verb_enabled ? (
    side_freq += d_side;
    lp_freq += d_lp;
    hp_freq += d_hp;
    current_verb_mix += d_verb;
    
    (reverb_algorithm != 3) ? (
      verb.update_verb_filters(damping_freq, lp_freq, hp_freq, side_freq);
      
      current_time = 0.9995 * current_time + 0.0005 * time_ms;
      ((current_time != last_time) || (current_seed != seed) || (current_reverb_algorithm != reverb_algorithm) || (current_feedback != low_feedback)) ? (
        current_seed = seed;
        last_time = current_time;
        current_feedback = low_feedback;
        current_reverb_algorithm = reverb_algorithm;
        verb.update_verb_settings(current_time, current_seed, current_reverb_algorithm, low_feedback);
      );
      verb.verb_tick(spl0, spl1);
    ) : (
      fft_verb.process_stft_verb(spl0, spl1);
      verb.out_left = fft_verb.out_left;
      verb.out_right = fft_verb.out_right;
    );
    
    
    spl0 = spl0 * (1.0 - current_verb_mix) + current_verb_mix * verb.out_left;
    spl1 = spl1 * (1.0 - current_verb_mix) + current_verb_mix * verb.out_right;
  );
  
  spl0 = brightness_boost.eval_linearSVF_shelf(spl0);
  spl1 = brightness_boost.eval_linearSVF_shelf2(spl1);
  
  spreader_active ? (
    spreader.spreader_tick(spl0, spl1, reconstruct_envelope, (last_active_notes == 0) && midi.active_notes);
    last_active_notes = midi.active_notes;
    spl0 = spreader.outL;
    spl1 = spreader.outR;
  );
  
  poisson_enabled ? (
    poisson.poisson_noise(spl0, spl1, poisson_freq, 0);
    spl0 = poisson.out_left;
    spl1 = poisson.out_right;
  );
  
  // Allpass processing
  allpass ? (
    _apf = current_ap_freq;
    smear_tracking ? (
      _apf *= 0.0022727272727273 * (
          (latest_voice == 0) ? v0.freq
          : (latest_voice == 1) ? v1.freq
          : (latest_voice == 2) ? v2.freq
          : (latest_voice == 3) ? v3.freq
          : (latest_voice == 4) ? v4.freq
          : (latest_voice == 5) ? v5.freq
          : (latest_voice == 6) ? v6.freq
          : (latest_voice == 7) ? v7.freq
          : (latest_voice == 8) ? v8.freq
          : (latest_voice == 9) ? v9.freq
          : (latest_voice == 10) ? v10.freq
          : (latest_voice == 11) ? v11.freq
        );
    );
    
    ap_coeff_last = ap_coeff;
    ap_coeff = max(-0.999999, min(0.999999, allpass_coeff(_apf)));
    spl0 += current_ap_fb * ap_lspl0;
    spl1 += current_ap_fb * ap_lspl1;
    spl0 = a1.allpass32(spl0, ap_coeff, ap_coeff_last, current_ap_sat);
    spl1 = a2.allpass32(spl1, ap_coeff, ap_coeff_last, current_ap_sat);
    ap_lspl0 = spl0;
    ap_lspl1 = spl1;
  );
  
  current_gain ? (
    spl0 *= current_gain;
    spl1 *= current_gain;
  ) : (
    spl0 = spl1 = 0;
  );
  
  audio_buffer[audio_buffer_idx] = 0.5 * (spl0 + spl1);
  audio_buffer_idx += 1;
  audio_buffer_idx > current_osc_buffer ? audio_buffer_idx = 0;
  
  current_f3_gain += df3_gain;
  current_f4_gain += df4_gain;
  current_gain += d_gain;
  
  current_ap_freq += d_ap_freq;
  current_ap_fb += d_ap_fb;
  current_ap_sat += d_ap_sat;
);

m_out_last = max(abs(spl0), abs(spl1));

spreader_active ? (
  ((dspread_slider != 0) || (dspread_mix != 0)) ? (
    spreader.spreader_update_parameters(current_spread_slider, current_spread_mix);
  );

  current_spread_slider = current_spread.smooth(spread_slider);
  current_spread_mix = current_spread_mix.smooth(spread_mix);
  current_spread_frequency = current_spread_frequency.smooth(spread_frequency);
);

@gfx 1050 768
(!active_text_input) ? (
  char = gfx_getchar();
  
  ((char == 9) && (last_char != 9)) ? (
    ((mouse_cap & 8) == 8) ? (
      show_semitones = 1 - show_semitones;
    ) : (
      show_precise_tuning = 1 - show_precise_tuning;
    );
  );
  
  (((char==70) || (char==102)) && (!((last_char==70) || (last_char==102)))) ? (
    font_choice += 1;
    font_choice > 2 ? (font_choice = 0);
    loaded = 0;
  );
);

function scolor(c)
local(frac)
global()
(
  (c < 0.5) ? (
    frac = c + c;
    gfx_set(
      0.098 * frac + 0.038 * (1 - frac),
      0.0863 * frac + 0.0601 * (1 - frac),
      0.0472 * frac + 0.064 * (1 - frac),
      0.05
    )
  ) : (
    frac = c + c - 1;
    gfx_set(
      0.038 * frac + 0.012 * (1 - frac),
      0.0601 * frac + 0.017 * (1 - frac),
      0.064 * frac + 0.0273 * (1 - frac),
      0.05
    );
  );
);

//loaded = 0;
!loaded ? (
  loaded = gfx_loadimg(12, "./protosynth_dependencies/font.png");
  (font_choice == 1) ? (
    loaded = gfx_loadimg(14, "./protosynth_dependencies/bigfont_caps3_dark.png");
    loaded = gfx_loadimg(16, "./protosynth_dependencies/bigfont_caps3.png");
  ) : (
    loaded = gfx_loadimg(14, "./protosynth_dependencies/bigfont_caps.png");
    loaded = gfx_loadimg(16, "./protosynth_dependencies/bigfont_caps_dark.png");
  );
 
  bigger_font = font_choice < 2;
  
  gfx_setimgdim(13, img_w, img_h);
  gfx_setimgdim(10, img_w, img_h);
  gfx_setimgdim(15, img_w * 2, img_h * 2);
  
  gfx_dest = 10; gfx_mode = 0;
  scolor(0); gfx_a = 1.0;
  gfx_rect(0, 0, img_w, img_h);
  
  _ix = img_w / 2;
  _iy = img_h / 2;
  gfx_dest = 10;
  gfx_mode = 5;
  
  0 ? (
    _s = 1;
    bg_alpha = 0.6;
    loop(5000,
      colormodel(0.3 + 0.6 * abs(sin(ix)));
      gfx_a = 0.1;
      
      _ic = max(0.0, min(1.0, _ic + 0.1 * rand() - 0.05));
      _ix = _ix + 30 * (rand() - 0.5) + 0.001 * (0.5 * img_w - _ix);
      _iy = _iy + 20 * (rand() - 0.5) + 0.001 * (0.5 * img_h - _iy);
      //gfx_circle(_ix, _iy, 25 + 200 * ix, 0);
      gfx_line(_ix, _iy, _ix + _s, _iy + _s, 0);
      gfx_line(_ix + 1, _iy + 1, _ix + _s + 1, _iy + _s + 1, 0);
      gfx_line(_ix + 2, _iy + 1, _ix + _s + 1, _iy + _s + 2, 1);
      ix += 0.001;
      _s += 0.001;
    );
  ) : (
    theme = 0;
    bg_alpha = 1.0;
    theme == 0 ? (
      light_theme = 0;
      loaded = gfx_loadimg(10, "./protosynth_dependencies/proto_bg_2.png");
    ) : ( theme == 1 ) ? (
      light_theme = 1;
      loaded = gfx_loadimg(10, "./protosynth_dependencies/proto_bg_4.png");
    );
  );
);

model = 1;

function reset_color()
(
  gfx_r = gfx_g = gfx_b = 0.0; gfx_a = 1.0;
  gfx_mode = 1;
);

bigger_font ? (
  gfx_dest = 15;
  //gfx_clear = 0;
  gfx_set(0, 0, 0, 1);
  gfx_a2 = 0;
  gfx_rect(0, 0, img_w * 2, img_h * 2);
);

// Background color
gfx_dest = 13;
gfx_clear = 0;
gfx_set(0, 0, 0, 1);
gfx_rect(0, 0, img_w, img_h);
gfx_mode = 4;
gfx_x = gfx_y = 0; gfx_a = bg_alpha;
gfx_blit(10, 1, 0);


function star(x, y, w)
instance(hwr)
local(hw)
global(gfx_r, gfx_g, gfx_b, gfx_a)
(
  hwr = 0.9 * hwr + 0.1 * w;
  colormodel(1.0); gfx_a = 0.3 * hwr;
  hw = ceil(hwr);
  gfx_rect(x - hw, y, 2 * hw + 1, 1);
  gfx_rect(x, y - hw, 1, 2 * hw + 1);
  (hw > 0) ? (
    gfx_r = gfx_g = gfx_b = 1.0;
    gfx_rect(x, y, 1, 1);
  );
);

function cloudline(x)
local(y)
(
    x < 59 ? (
        y = 158 + <?printf("%f", (130-158)/(59-0))?>*(x-0);
    ) :
    x < 118 ? (
        y = 130 + <?printf("%f", (134-130)/(118-59))?>*(x-59);
    ) :
    x < 155 ? (
        y = 134 + <?printf("%f", (154-134)/(155-118))?>*(x-118);
    ) :
    x < 208 ? (
        y = 154 + <?printf("%f", (188-154)/(208-155))?>*(x-155);
    ) :
    x < 302 ? (
        y = 188 + <?printf("%f", (99-188)/(302-208))?>*(x-208);
    ) :
    x < 325 ? (
        y = 99 + <?printf("%f", (76-99)/(325-302))?>*(x-302);
    ) :
    (
        y = 76 + <?printf("%f", (84-76)/(349-325))?>*(x-325);
    );

    y;
);

function comet(img_w, img_h, grav)
local(i, tt0, tt1, x0, y0, x1, y1, a, life, burn, curtail, alpha)
global(gfx_r, gfx_g, gfx_b, gfx_a)
instance(t, sx, sy, vx, vy, tmax, tail)
(
  t = t + 2;
  (t >= tmax) ? (
    rand() < 0.01 ? (
      sx = rand() * img_w;
      sy = rand() * img_h / 4;
      (sy > cloudline(sx)) ? sy = rand() * img_h;
      
      t = 0;
      tmax = 30 + rand() * 20;
      vx = 3.0 + 1.5 * rand();
      vy = 0.8 + 0.4 * rand();
      tail = 25 + rand() * 10;
    );
  ) : (
    life = (tmax - t) / tmax;

    gfx_r = 0.80;
    gfx_g = 0.74;
    gfx_b = 1.00;

    curtail = max(2, floor(tail * life));
    alpha = life * (0.85 + 0.15 * rand());

    i = 1;
    loop(curtail,
        tt0 = max(0, t - i);
        tt1 = max(0, t - i + 1);

        x0 = sx + vx*tt0;
        y0 = sy + vy*tt0 + grav*tt0*tt0;

        x1 = sx + vx*tt1;
        y1 = sy + vy*tt1 + grav*tt1*tt1;

        a = (curtail - i) / curtail;
        gfx_a = a * a * alpha;

        (y1 < cloudline(x1)) ? (
          gfx_line(x0, y0, x1, y1);
          gfx_line(x0 + 1, y0 + 1, x1 + 1, y1 + 1);
          gfx_a = 0.5 * gfx_a;
          gfx_circle(x1, y1, 2, 1);
        );

        i += 1;
    );

    x1 = sx + vx*t;
    y1 = sy + vy*t + grav*t*t;

    (y1 < cloudline(x1)) ? (
      gfx_r = 0.70;
      gfx_g = 0.84;
      gfx_b = 1.00;
     
      gfx_a = 0.01;
      gfx_circle(x1, y1, 20, 1);
      gfx_circle(x1, y1, 50, 1);
     
      gfx_a = 0.15;
      gfx_circle(x1, y1, 4, 1);
      
      gfx_a = 0.20;
      gfx_circle(x1, y1, 2.5, 1);
      
      gfx_circle(x1, y1, 1.5, 1);
      
      gfx_a = 0.8;
      gfx_circle(x1, y1, 1, 1);
    );
  );
);

(theme == 0) ? (
  gfx_mode = 1;
  st1.star(118, 181, 2 * rand() - 0.1);
  st2.star(215, 152, 1.5 * rand());
  st6.star(215, 151, 3 * rand());
  st3.star(257, 152, 3.5 * rand());
  st4.star(241, 130, 2 * rand());
  st5.star(258, 91, 1.5 * rand());
  c1.comet(img_w, img_h, 0.06);
);

reset_color();
gfx_mode = 0;

gfx_a = 0.1;
pad_width = 70;
pad_height = 70;
pad_spacing = 31;

side_pad = 4;
toggle_size = 6;

gfx_set(0.7, 0.5, 0.2, 0.3);
cx = side_pad;
cy = 2;

MODULATOR_STRING=34;
sprintf(MODULATOR_STRING, "Modulator to apply\n\nRight click to select modulator source.\nLeft click and drag to change modulation depth.");

<?
  function uuid()
  (
    next_uuid += 1
  );
  
  function text_uuid()
  (
    next_uuid += 1
  );
  
  loop(i=0;8,
    printf("cx = side_pad;\n");
    
    printf("_osc%d_alpha = 0.7 * _osc%d_alpha + 0.2 * 0.3 * (over_osc == %d);", i + 1, i + 1, i + 1);
    printf("gfx_set(1.0, 1.0, 1.0, _osc%d_alpha);", i + 1);
    printf("gfx_rect(cx - 1, cy, 252, 8, 1);");
    
    printf("osc%d_enabled.color = any_solo ? (osc%d_solo ? 101 : 100) : 0;", i + 1, i + 1);
    printf("osc_click = osc%d_enabled.simple_serialize_toggle(cx, cy + 1, toggle_size, osc%d_enabled || osc%d_solo, \"Enable Oscillator %d\", \"Enable OSC%d\");\n", i + 1, i + 1, i + 1, i + 1, i + 1);
    printf("(osc_click == 1) ? (osc%d_enabled = 1 - osc%d_enabled;);\n", i + 1, i + 1);
      printf("(osc_click == 2) ? (osc%d_solo = 1 - osc%d_solo;);\n", i + 1, i + 1);
    printf("cx += toggle_size + 2;\n");
    printf("dark_font = light_theme;");
    printf("txt_blit(\"OSC%d\", cx, cy + 2); cx += 25;", i + 1);
    printf("dark_font = 0;");
    
    printf("osc%d_type > 8 ? (", i + 1);
      printf("bp_mode%d_enabled.simple_serialize_toggle(cx - 4, cy, 3, resonator_mode%d, \"Bandpass mode %d\", \"BP mode%d\") ? (resonator_mode%d = 1 - resonator_mode%d);\n", i + 1, i + 1, i + 1, i + 1, i + 1, i + 1);
      printf("out_mode%d_enabled.simple_serialize_toggle(cx - 4, cy + 4, 3, out_mode%d, \"Bypass output shaping %d\", \"Out mode%d\") ? (out_mode%d = 1 - out_mode%d);\n", i + 1, i + 1, i + 1, i + 1, i + 1, i + 1);
    printf(");");
    
    printf("osc_type_slider%d.rounding_increment = 1;", i + 1);
    printf("osc_type_slider%d.current_value = osc%d_type;", i + 1, i + 1);
    printf("osc_type_slider%d.text_slider_ui(%d, cx, cy, 4 * toggle_size + 4, 8, sprintf(9, \"%%s\", osc_type(osc%d_type, wt%d.sample_data_length)), \"Type\n\nHARM  - Harmonic series with customizable spacing\nSSAW  - SuperSaw with customizable detune\nPeak  - Formant-like filtering\nNoise - Noise with customizable resonance\nWT    - Wavetable (drag and drop sample here).\", \"Type\"); cx += 4 * toggle_size + 4 + 2;", i + 1, uuid(), i + 1, i + 1);
    
    printf("(osc_type_slider%d.over && (mouse_cap == 2) && (last_cap == 0)) ? (\n", i + 1);
      printf("gfx_x = mouse_x;");
      printf("gfx_y = mouse_y;");
      printf("ix = gfx_showmenu(\"Harmonic series|Super saw|Formant/Peak|Noise|Wavetable|Pulse|Bipolar Pulse|Triangle|Razor|Metal|Tube|Beating|Beam open|Beam closed|Membrane|Marimba|Pan\");");
      printf("  (ix > 0) ? (");
        printf("    osc_type_slider%d.current_value = ix - 1;", i + 1);
      printf("  );");
    printf(");");
    
    printf("osc_type_slider%d.over ? (\n", i + 1);
      printf("wt%d.handle_dropped_files() ? ( wt%d.create_wavetable(); osc_type_slider%d.current_value = 4;);\n", i + 1, i + 1, i + 1);
    printf(");\n");
    
    printf("osc%d_type = osc_type_slider%d.current_value;", i + 1, i + 1);
    
    printf("gain_slider%d.rounding_increment = 1;", i + 1);
    printf("gain_slider%d.modulator_field(%d, cx, cy, 8, 1, \"Gain envelope to apply\", \"OSC Envelope\", 1, 6, 0);\n cx += 10;", i + 1, uuid());
    printf("gain_slider%d.text_slider_ui(%d, cx, cy, 5 * toggle_size + 4, 8, sprintf(9, \"%%\.1f\", gain_slider%d.display_value), \"Gain\", \"Gain\"); cx += 5 * toggle_size + 4 + 1;", i + 1, uuid(), i + 1);
    printf("gain_slider%d.modulator_field(%d, cx, cy, 8, 1, MODULATOR_STRING, \"OSC Envelope\", 0, N_SELECTABLE_MODULATORS, 1);\n cx += 10;", i + 1, uuid())  ;
    printf("gain_slider%d.check_text_input_defaults();", i + 1);
    
    printf("show_precise_tuning ? (\n");
      printf("osc_offset_slider%d.rounding_increment = 0;", i + 1);
      printf("osc_offset_slider%d.active = osc%d_type < 3;", i, i);
      printf("osc_offset_slider%d.text_slider_ui(%d, cx, cy, 5 * toggle_size + 4 + 9, 8, sprintf(9, \"%%\.1f\", osc%d_hz_tune), \"Absolute Tuning (Hz)\", \"Abs Tuning\"); cx += 5 * toggle_size + 4 + 1;", i + 1, uuid(), i + 1);
      printf("cx += 10;");
      printf("osc_offset_slider%d.check_text_input_defaults();", i + 1);
      
      printf("spacing_offset_slider%d.active = osc%d_type == 0;", i, i);
      printf("spacing_offset_slider%d.text_slider_ui(%d, cx, cy, 5 * toggle_size + 4 + 9, 8, sprintf(9, \"%%\.1f\", osc%d_spacing_offset), \"Partial offset\", \"Partial offset\"); cx += 5 * toggle_size + 4 + 1;", i + 1, uuid(), i + 1);
      printf("cx += 10;");
      printf("spacing_offset_slider%d.check_text_input_defaults();", i + 1);
    printf(") : (\n");
