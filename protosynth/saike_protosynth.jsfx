img_w = 350;
img_h = 256;
osc_downsample_factor = osc_downsample_factor ? osc_downsample_factor : 16;
max_osc_downsample_factor = 128;
osc_skipfactor = 2;
osc_buffer = img_w * max_osc_downsample_factor;


function draw_oscilloscope(x, y, w, h)
global(
  gfx_x, gfx_y, gfx_r, gfx_g, gfx_b, gfx_a, gfx_mode, color_model,
  audio_buffer, x_step, osc_downsample_factor, osc_skipfactor,
  img_w, current_osc_buffer,
  mouse_x, mouse_y, mouse_cap, last_cap,
  x_offset, y_offset, blit_scale,
)
local(ix, yc, hh, phh, y_top, y_bottom, mouse_nx, mouse_ny)
instance()
(
  mouse_nx = (mouse_x - x_offset) / blit_scale;
  mouse_ny = (mouse_y - y_offset) / blit_scale;
  
  ((mouse_cap == 2) && (last_cap == 2)) ? (
    ((mouse_nx > x) && (mouse_nx < (x + w)) && (mouse_ny > y) && (mouse_ny < (y + h))) ? (
      gfx_x = mouse_x;
      gfx_y = mouse_y;
      ix = gfx_showmenu(
        sprintf(
          9, "%s8|%s16|%s32|%s48|%s64|%s128",
          osc_downsample_factor==8 ? "!" : "",
          osc_downsample_factor==16 ? "!" : "",
          osc_downsample_factor==32 ? "!" : "",
          osc_downsample_factor==48 ? "!" : "",
          osc_downsample_factor==64 ? "!" : "",
          osc_downsample_factor==128 ? "!" : ""
        )
      );
      (ix > 0) ? (
        osc_downsample_factor = 
          (ix == 1) ? ( 8 )
          : (ix == 2) ? ( 16 )
          : (ix == 3) ? ( 32 )
          : (ix == 4) ? ( 48 )
          : (ix == 5) ? ( 64 )
          : (ix == 6) ? ( 128 );
      );
    );
  );
  
  current_osc_buffer = img_w * osc_downsample_factor;
  gfx_x = x;
  ix = 0;
  
  colormodel(0.4);
  gfx_mode = 1;
  //gfx_a = 0.4;
  gfx_a = min(1, 5 / osc_downsample_factor);
  hh = 0.5 * h;
  phh = h;//0.5 * h;
  yc = y + hh;
  y_top = y + h - 2;
  y_bottom = y + 2;
  x_step = w / (current_osc_buffer / osc_skipfactor);
  loop(current_osc_buffer / osc_skipfactor,
    gfx_y = yc + audio_buffer[ix] * phh;
    (gfx_y < y_top) && (gfx_y > y_bottom) ? (
      gfx_setpixel(gfx_r, gfx_g, gfx_b);
    );
    ix += osc_skipfactor;
    gfx_x += x_step;
  );
);

