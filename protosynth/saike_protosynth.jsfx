poisson_slider.slider_ui(<?printf("%d", uuid(););?>, fx_origin + hw + 1, cy, hw, 8, sprintf(9, "%d", poisson_freq), "Poisson noise", "Noisiness");

noise_slider1.rounding_increment = 0.01;
noise_slider1.slider_ui(<?printf("%d", uuid(););?>, fx_origin, cy, hw, 8, sprintf(1, "%0.1f", 100 * noise), "Pitch noise", "Pitch noise");
noise_slider1.check_text_input(<?printf("%d", uuid(););?>) ? ( slider(noise_slider1.sl) = max(noise_slider1.sl_min, min(noise_slider1.sl_max, text_box.result / 100)); );

cy += 10;

