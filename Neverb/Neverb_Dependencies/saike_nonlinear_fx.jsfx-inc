@init
function compander_compress(x)
local()
global()
instance(y_comp, y_comp_current, alpha_compander)
(
  alpha_compander = 0.001;
  y_comp == 0 ? y_comp = abs(x);
  y_comp = abs(y_comp_current) * alpha_compander + y_comp * (1-alpha_compander);
  y_comp_current = x / (.0001 + y_comp)
);

function compander_expand(x)
local()
global()
instance(y_expand, alpha_compander)
(
  y_expand = max(0.01, abs(x)) * alpha_compander + y_expand * (1-alpha_compander);

  x * y_expand
);

function compander_compress(x)
local()
global()
instance(y_comp, alpha_compander)
(
  alpha_compander = 0.001;
  y_comp = max(0.01, abs(x)) * alpha_compander + y_comp * (1-alpha_compander);
  x / (.0001 + y_comp)
);


function compander_expand(x)
local()
instance(y_comp)
(
  x * y_comp
);

function lp_fuzz(ar_uni)
instance(p, w)
global()
(
  w = ar_uni * w + rand() - 0.5
);


function crackle(rate, amount)
instance(
  next_event,
  burst_env,
  burst_decay,
  density,
  density_target,
  density_slew,
  click_lp,
  noise_state,
  initialized,
  click_lp_coeff
)
local(
  r,
  event_amp,
  white,
  click,
  out
)
global(srate)
(
  initialized == 0 ? (
    next_event = 1;
    burst_env = 0;
    burst_decay = 0;
    density = 1;
    density_target = 1;
    density_slew = 0.00002;
    click_lp = 0;
    noise_state = 0;
    click_lp_coeff = 1 - exp(-1 / (srate * 0.0015));
    initialized = 1;
  );

  density_slew = 0.01;
  density_target += (rand(1) - 0.5) * density_slew;

  density_target < 0 ? density_target = 0;
  density_target > 1.8  ? density_target = 1.8;

  density += (density_target - density) * density_slew;

  next_event -= 1;

  next_event <= 0 ? (
    r = rand(1);
    event_amp = rand(1) * 0.05 + r * r * r * 0.65;
    burst_decay = exp(
      -1 / (srate * (0.0015 + rand(1) * 0.08))
    );

    r < 0.5 ? event_amp = - event_amp;
    burst_env = event_amp;

    rand(1) < 0.035 ? (
      burst_env *= 2.5 + rand(1) * 3;
    );

    r = rand(1);
    r < 0.000001 ? r = 0.000001;

    next_event = -log(r) * srate / (max(0.001, rate) * density);
  );


  burst_env *= burst_decay;
  white = rand(1) * 2 - 1;

  click_lp += (white - click_lp) * click_lp_coeff;
  click = burst_env * (0.75 + 0.25 * click_lp);

  // Return the sample.
  click * amount * 200;
);

function granckle(rate, amount, playrate)
instance(next_event, source_pos, grain_len, attack, decay, env_norm, density, density_target, density_slew, initialized, peak_t, grain_amp, e1, e2, k1, k2)
local(r, t, src, env, grain_spl)
global(verb, srate, verb.read_delay, verb.d6, verb.p)
(
  initialized == 0 ? (
    next_event = 1; source_pos = 1;
    density = 1; density_target = 1; density_slew = 0.01;
    initialized = 1;
  );

  density_target += (rand(1) - 0.5) * density_slew;
  density_target = min(1.8, max(0, density_target));
  density += (density_target - density) * density_slew;

  next_event -= 1;

  (next_event <= 0) ? (
    r = rand(1);
    grain_len = 0.01 + rand(1) * 0.02;
    attack = grain_len * (0.1 + rand(1) * 1.2);
    decay = grain_len * (0.8 + rand(1) * 2.5);

    r = rand(1);
    r < 0.000001 ? r = 0.000001;
    next_event = -log(r) * srate / (max(0.001, rate) * density);

    peak_t = attack * decay / (decay - attack) * log(decay / attack);
    env_norm = 1 / (exp(-peak_t / decay) - exp(-peak_t / attack));
    
    grain_amp = rand(1) * 0.05 + r * r * r * 0.65;
    rand(1) < 0.5 ? grain_amp = -grain_amp;

    e1 = env_norm;
    e2 = - env_norm;
    k1 = exp(-1 / (srate * decay));
    k2 = exp(-1 / (srate * attack));

    source_pos = 1;
  ) : (next_event < 15) ? (
    // Rapid fade
    k1 *= 0.4;
    k2 *= 0.4;
  );

  env = e1 + e2;
  e1 *= k1;
  e2 *= k2;

  src = verb.read_delay(verb.d6, verb.p, source_pos);
  source_pos += playrate;

  grain_spl = src * grain_amp * env * amount;
  grain_spl * 2000;
);


_MAX_TARGET_FREQ = 20000;
_MIN_TARGET_FREQ = 50;
function init_detector()
global(srate)
local()
instance(hp_a, fast_a, fast_r, slow_a, amount_r)
(
  hp_a = exp(-2 * $pi * 830 / srate);  // Detector freq
  fast_a = exp(-1 / (0.2 * 0.001 * srate));  // Fast attack follower
  fast_r = exp(-1 / (15 * 0.001 * srate));  // Slow follower
  slow_a = exp(-1 / (30 * 0.001 * srate)); // Slow attack
  amount_r = exp(-1 / (30 * 0.001 * srate));
);

function detector(input, thresh)
instance(
  hp1, hp2,
  fast_env, slow_env,
  amount_env,
  hp_a, fast_a, fast_r, slow_a, amount_r,
  hp, hf, ratio_db, amount
)
(
  hp1 = hp_a * hp1 + (1 - hp_a) * input;
  hp = input - hp1;

  hp2 = hp_a * hp2 + (1 - hp_a) * hp;
  hf = hp - hp2;
  hf = abs(hf);

  hf > fast_env ? fast_env = fast_env * fast_a + hf * (1 - fast_a) : fast_env *= fast_r;

  slow_env = slow_env * slow_a + hf * (1 - slow_a);

  ratio_db = 20 * log10((fast_env + 0.00001) / (slow_env + 0.0000001));

  amount = max(0, ratio_db - thresh);
  amount = min(amount / 12, 1);

  amount > amount_env ? amount_env = amount : amount_env *= amount_r;

  _MAX_TARGET_FREQ * (1 - amount_env) + _MIN_TARGET_FREQ * amount_env;
);

function circ_buffer_mono(freemem, size)
local()
instance(buffer, buffer_end, write_ptr, mask)
global()
(
  buffer = freemem;
  write_ptr = 0;
  mask = size - 1;
  buffer_end = buffer + size
);

function init_simple_diffuser(freemem)
local(drift_update_time_seconds, circ_buffer_size)
instance(
  drift, drift_target, drift_counter, drift_update_samples, drift_amount
  buf_dA1, buf_dA2, buf_dA3, buf_dA4, buf_dB1, buf_dB2l, buf_dB2r,
  delayA1, delayA2, delayA3, delayA4, delayB1, delayB2_left, delayB2_right,
)
global(srate)
(
  circ_buffer_size = 8192;
  drift = 0;
  drift_target = 0;
  
  drift_counter = 0;
  drift_update_time_seconds = 0.2;
  drift_update_samples = drift_update_time_seconds * srate;
  drift_amount = 0.60 / 1000 * srate;
  
  // Fixed sample delay lines (don't need interpolation / no loss)
  delayA3 = floor(3.6 / 1000 * srate);
  delayA4 = floor(12.7 / 1000 * srate);
  delayB1 = floor(7.1 / 1000 * srate);
  
  delayA1 = floor(15.3 / 1000 * srate);
  delayA2 = floor(12.1 / 1000 * srate); // Set to 72.1 for delay-like
  
  // Decorrelation (hermite ahoy :D)
  delayB2_left = floor(9.3 / 1000 * srate);
  delayB2_right = floor(9.731 / 1000 * srate);
  
  freemem = buf_dA1.circ_buffer_mono(freemem, circ_buffer_size);  // A1
  freemem = buf_dA2.circ_buffer_mono(freemem, circ_buffer_size * 4);  // A2
  
  freemem = buf_dA3.circ_buffer_mono(freemem, circ_buffer_size);  // A3
  freemem = buf_dA4.circ_buffer_mono(freemem, circ_buffer_size);  // A4
  
  freemem = buf_dB1.circ_buffer_mono(freemem, circ_buffer_size);  // B1
  
  freemem = buf_dB2l.circ_buffer_mono(freemem, circ_buffer_size);  // B2  left
  freemem = buf_dB2r.circ_buffer_mono(freemem, circ_buffer_size);  // B2  right
);

function init_harmonizer(freemem)
local()
instance(pitch_sampling, pitch_sampling2, circ_buffer, half_buffer, harm_offset, harm_offset2)
global(srate)
(
  circ_buffer = 4096;
  freemem = pitch_sampling.circ_buffer_mono(freemem, circ_buffer);
  freemem = pitch_sampling2.circ_buffer_mono(freemem, circ_buffer);
  
  harm_offset = 0;
  harm_offset2 = circ_buffer * 0.25;
  
  freemem
);

// Hermite
function mask_interpolator(offset)
local(
  c1, c2, c3,
  read_pos,
  read_idx,
  frac,
  xm1, x0, x1, x2
  _mask,
)
instance(buffer, write_ptr, mask)
global()
(
  _mask = mask;
  
  // Read position relative to current write position
  read_pos = write_ptr - offset;

  read_idx = read_pos|0;
  frac = read_pos - read_idx;

  // Wrap indices
  xm1 = buffer[(read_idx - 1) & _mask];
  x0  = buffer[ read_idx      & _mask];
  x1  = buffer[(read_idx + 1) & _mask];
  x2  = buffer[(read_idx + 2) & _mask];

  // 4-point Hermite interpolation
  c1 = 0.5 * (x1 - xm1);
  c2 = xm1 - 2.5*x0 + 2*x1 - 0.5*x2;
  c3 = 1.5*(x0 - x1) + 0.5*(x2 - xm1);

  ((c3 * frac + c2) * frac + c1) * frac + x0;
);

// Quadratic (cheaper)
function mask_interpolator(offset)
local(
  read_pos,
  read_idx,
  frac,
  xm1, x0, x1,
  a, b, c
)
instance(buffer, write_ptr, mask)
(
  read_pos = write_ptr - offset;

  read_idx = read_pos|0;
  frac = read_pos - read_idx;

  xm1 = buffer[(read_idx - 1) & mask];
  x0  = buffer[ read_idx      & mask];
  x1  = buffer[(read_idx + 1) & mask];

  // 3-point Lagrange
  a = 0.5 * frac * (frac - 1);
  b = -(frac + 1) * (frac - 1);
  c = 0.5 * frac * (frac + 1);

  xm1*a + x0*b + x1*c;
);

<?
  function print_reader(buffer_name, offset_variable)
  (
      printf("%s.buffer[(%s.write_ptr - %s) & %s.mask]", buffer_name, buffer_name, offset_variable, buffer_name);
  );
?>

<?
  function store_sample(buffer_name, sample_name)
  (
      printf("%s.buffer[%s.write_ptr] = %s;", buffer_name, buffer_name, sample_name);
      printf("%s.write_ptr = (%s.write_ptr + 1) & %s.mask;", buffer_name, buffer_name, buffer_name);
  );
?>

function add_sample_mono(sample)
local()
global()
instance(buffer, write_ptr, buffer_end)
(
  write_ptr[] = sample;
  write_ptr += 1;
  (write_ptr == buffer_end) ? write_ptr = buffer;
);

function update_diffuser_params(semitones, density, drift, delay)
local()
global(srate)
instance(playhead_speed, high_density, drift_level, playhead_speed2, delayA2, harm_offset, harm_offset2, circ_buffer)
(
  density ? (
    playhead_speed = 1 - pow(2, max(-1000, semitones - 0.02) / 12);
    playhead_speed2 = 1 - pow(2, max(-1000, semitones + 0.02) / 12);
    
    (high_density != density) ? (
      harm_offset2 = harm_offset + circ_buffer * 0.24;
      (harm_offset2 < 0) ? harm_offset2 = circ_buffer;
      (harm_offset2 > circ_buffer) ? harm_offset2 = 0;
    );
  ) : (
    playhead_speed = 1 - pow(2, max(-1000, semitones) / 12);
  );
  high_density = density;
  delayA2 = floor(12.1 * exp(log(160/12.1) * delay) / 1000 * srate);
  drift_level = drift;
);

function eval_simple_diffuser(s0)
local(
  r,
  k1, k2, k3,
  A_s,
  delayed,
  A_d1, A_d2, A_d3, A_d4, y, gain, phase,
  pitch_drift,
)
instance(
  drift, drift_target, drift_counter, drift_update_samples, drift_amount, drift_level,
  
  buf_dA1, buf_dA2, buf_dA3, buf_dA4, buf_dB1, buf_dB2l, buf_dB2r,
  delayA1, delayA2, delayA3, delayA4, delayB1, delayB2_left, delayB2_right,
  
  out_left, out_right,
  
  pitch_sampling, pitch_sampling2,
  harm_offset, harm_offset2, circ_buffer, buf_center, playhead_speed, playhead_speed2, high_density, ddrift,
)
global()
(
  //////////////////////
  // DIFFUSION STAGE
  //////////////////////
  
  // Nested allpass
  A_d1 = <?print_reader("buf_dA1", "delayA1")?>;
  A_d2 = <?print_reader("buf_dA2", "delayA2")?>;
   
  k1 = 0.5;
  k2 = 0.3;
  y = A_d2 - k2 * A_d1 - k1 * s0;
  <?store_sample("buf_dA1", "s0 + k1 * y")?>
  <?store_sample("buf_dA2", "A_d1 + k2 * (A_d2 - k2 * A_d1)")?>

  <?store_sample("pitch_sampling2", "y")?>

  // Simple allpass
  k3 = 0.85;
  delayed = <?print_reader("buf_dB1", "delayB1")?>;
  A_s = y - k3 * delayed;
  <?store_sample("buf_dB1", "A_s")?>
  y = k3 * A_s + delayed;

  //////////////////////
  // DIFFUSION STAGE
  //////////////////////
  A_d3 = <?print_reader("buf_dA3", "delayA3")?>;
  A_d4 = <?print_reader("buf_dA4", "delayA4")?>;
  
  s0 = y;
  k1 = 0.5;
  k2 = 0.3;
  y = A_d3 - k2 * A_d4 - k1 * s0;
  <?store_sample("buf_dA3", "s0 + k1 * y")?>
  <?store_sample("buf_dA4", "A_d3 + k2 * (A_d4 - k2 * A_d3)")?>

  //////////////////////
  // HARMONIZER
  //////////////////////
  pitch_drift = drift * drift_level;
  harm_offset += playhead_speed;
  (harm_offset < 0) ? harm_offset = circ_buffer;
  
  (harm_offset > circ_buffer) ? harm_offset = 0;
  buf_center = circ_buffer / 2;
  
  phase = 1.0 - abs(harm_offset - buf_center) / buf_center;
  gain = phase * phase * (3.0 - 2.0 * phase);
 
  <?store_sample("pitch_sampling", "y")?>
  y = pitch_sampling.mask_interpolator(harm_offset) * sqrt(gain);
  y += pitch_sampling2.mask_interpolator(harm_offset + buf_center + (1 - gain) * pitch_drift) * sqrt(1 - gain);
  
  high_density ? (
    harm_offset2 += playhead_speed2;
    (harm_offset2 < 0) ? harm_offset2 = circ_buffer;
    (harm_offset2 > circ_buffer) ? harm_offset2 = 0;
    
    phase = 1.0 - abs(harm_offset2 - buf_center) / buf_center;
    gain = phase * phase * (3.0 - 2.0 * phase);
    y += pitch_sampling2.mask_interpolator(harm_offset2) * sqrt(gain);
    y += pitch_sampling.mask_interpolator(harm_offset2 + buf_center - (1 - gain) * pitch_drift) * sqrt(1 - gain);
    y *= 0.6;
  );
  
  //////////////////////
  // STEREOIZE OUTPUT
  //////////////////////
  drift_counter += 1;
  (drift_counter >= drift_update_samples) ?
  (
    drift_counter = 0;
    r = rand(1);
    drift_target = (r + r - 1) * drift_amount;
    ddrift = (drift_target - drift) / drift_update_samples
  );

  drift += ddrift;

  k3 = 0.5;
  delayed = buf_dB2l.mask_interpolator(delayB2_left + drift);
  //delayed = <?print_reader("buf_dB2l", "delayB2_left")?>;
  A_s = y - k3 * delayed;
  <?store_sample("buf_dB2l", "A_s")?>
  out_left = k3 * A_s + delayed;

  delayed = buf_dB2r.mask_interpolator(delayB2_right + drift);
  //delayed = <?print_reader("buf_dB2r", "delayB2_right")?>;
  A_s = y - k3 * delayed;
  <?store_sample("buf_dB2r", "A_s")?>
  out_right = k3 * A_s + delayed;
);

function init_bandsplit(cutoff1, cutoff2)
local()
instance(k_lpf, k_hpf)
global(srate)
(
  k_lpf = tan($pi * (cutoff1 / srate - 0.25)) * 0.5 + 0.5;
  k_hpf = tan($pi * (cutoff2 / srate - 0.25)) * 0.5 + 0.5;
);

function bandsplit(left, right)
local(r)
instance(
  k_lpf, k_hpf,
  s1l, s3l, s1r, s3r
  
  left_low, left_mid, left_high,
  right_low, right_mid, right_high,
)
global()
(
  left_low = s1l + k_lpf * (left - s1l);
  s1l = left_low + left_low - s1l;
  
  r = (1 - k_hpf) * s3l + k_hpf * left;
  s3l = r + r - s3l;
  left_high = left - r;
  
  left_mid = (left - left_low - left_high);
  
  right_low = s1r + k_lpf * (right - s1r);
  s1r = right_low + right_low - s1r;
  
  r = (1 - k_hpf) * s3r + k_hpf * right;
  s3r = r + r - s3r;
  right_high = right - r;
  
  right_mid = (right - right_low - right_high);
  
  0
);

function modulate_widths(low_width, mid_width, high_width)
local(M, S)
instance(left_low, left_mid, left_high, right_low, right_mid, right_high)
global()
(
  M = (left_low + right_low) * 0.5;
  S = (left_low - right_low) * 0.5 * low_width;
  
  left_low = M + S;
  right_low = M - S;
  
  M = (left_mid + right_mid) * 0.5;
  S = (left_mid - right_mid) * 0.5 * mid_width;
  
  left_mid = M + S;
  right_mid = M - S;
  
  M = (left_high + right_high) * 0.5;
  S = (left_high - right_high) * 0.5 * high_width;
  
  left_high = M + S;
  right_high = M - S;  
);

function front_back(s0, s1, front_back)
local(amnt)
global()
instance(
  fb,
  out_left, out_right,
  left_low, left_mid, left_high,
  right_low, right_mid, right_high,
)
(
  this.bandsplit(s0, s1);
  fb = 0.99 * fb + 0.01 * front_back;  
  
  fb > 0 ? (
    // widths front 0.5,  0.5, 0.5
    // widths center 0.7  1.0  1.0
    
    this.modulate_widths(0.7 - 0.2 * fb, 1.0 - 0.6 * fb, 1.0 - 0.5 * fb);
  
    out_left = left_low + left_mid + left_high * (1 + 0.26 * fb);
    out_right = right_low + right_mid + right_high * (1 + 0.26 * fb);
  ) : (
    amnt = - fb;
    
    // widths back 0.8,  0.9, 0.7
    // widths center 0.7  1.0  1.0
    
    this.modulate_widths(0.7 + 0.3 * fb, 1.0 - 0.1 * fb, 1.0 - 0.3 * fb);
    
    out_left = left_low * (1 + 0.08 * amnt) + left_mid * (1.0 - 0.09 * amnt) + left_high * (1 - 0.3 * amnt);
    out_right = right_low * (1 + 0.08 * amnt) + right_mid * (1.0 - 0.09 * amnt) + right_high * (1 - 0.3 * amnt);
  );
);

function smart(s0, s1, front_back)
local(amnt, tfb)
global()
instance(
  fb,
  out_left, out_right,
  left_low, left_mid, left_high,
  right_low, right_mid, right_high,
)
(
  this.bandsplit(s0, s1);
  fb = 0.99 * fb + 0.01 * front_back;  
  
    // widths front 0.5,  0.5, 0.5
    // widths center 0.7  1.0  1.0
  tfb = fb * fb;
  this.modulate_widths(tfb * tfb, tfb, 1.0);

  out_left = left_low + left_mid + left_high * (1 + 0.26 * fb);
  out_right = right_low + right_mid + right_high * (1 + 0.26 * fb);
);

function movement_filter(x, f_k, Q)
local(omega, alpha, A, c, gain_db, y)
instance(x1, x2, y1, y2, b0, b1, b2, a0, a1, a2, last_f)
global(srate)
(
  f_k = max(f_k, 140);
  (abs(f_k - last_f) > 5) ? (
    gain_db = 8.3;
    omega = 2 * $pi * f_k / srate;
  
    A = 10^(gain_db / 40);
    alpha = sin(omega) / (2 * Q);
    c = cos(omega);
  
    b0 = 1 + alpha * A;
    b1 = -2 * c;
    b2 = 1 - alpha * A;
  
    a0 = 1 + alpha / A;
    a1 = -2 * c;
    a2 = 1 - alpha / A;
  
    b0 /= a0;
    b1 /= a0;
    b2 /= a0;
    a1 /= a0;
    a2 /= a0;
    
    last_f = f_k;
  );

  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;

  x2 = x1;
  x1 = x;
  y2 = y1;
  y1 = y;

  y - x;
);

function movement_resonators(left, right)
global(resonator_r1, resonator_r2)
instance(
  resonator_delta, resonator_delta2, resonator_delta3, resonator_delta4,
  res1, res2, res3, res4, res5, res6
  out_left, out_right,
)
local(r1, r2, r3, r4, r5, r6)
(
  resonator_delta += rand() - 0.5;
  resonator_delta *= resonator_r1;
  resonator_delta2 += rand() - 0.5;
  resonator_delta2 *= resonator_r2;
  
  resonator_delta3 += rand() - 0.5;
  resonator_delta3 *= resonator_r1;
  resonator_delta4 += rand() - 0.5;
  resonator_delta4 *= resonator_r2; 
  r1 = res1.movement_filter(left, 580 + resonator_delta, 3.3);
  r2 = res2.movement_filter(right, 460 + resonator_delta + resonator_delta2, 2.3);
  r3 = res3.movement_filter(left, 320 + resonator_delta3, 8.1);
  r4 = res4.movement_filter(right, 280 + resonator_delta3 + resonator_delta4, 9.1);
  r5 = res5.movement_filter(left, 420 + resonator_delta3 - resonator_delta2, 24.1);
  r6 = res6.movement_filter(right, 510 - resonator_delta - resonator_delta3 - resonator_delta4, 17.1);
  out_left = r1 + r3 + r5 - r4;
  out_right = r2 + r4 + r6 - r3;
);

function movement_resonators2(left, right)
global(resonator_r1, resonator_r2)
instance(
  resonator_delta, resonator_delta2, resonator_delta3, resonator_delta4,
  res1, res2, res3, res4, res5, res6
  out_left, out_right,
)
local(r1, r2, r3, r4, r5, r6)
(

  resonator_delta += rand() - 0.5;
  resonator_delta *= resonator_r1;
  resonator_delta2 += rand() - 0.5;
  resonator_delta2 *= resonator_r2;
  
  resonator_delta3 += rand() - 0.5;
  resonator_delta3 *= resonator_r1;
  resonator_delta4 += rand() - 0.5;
  resonator_delta4 *= resonator_r2; 
  r1 = res1.movement_filter(left, 3580 + 10*resonator_delta, 13.3);
  r2 = res2.movement_filter(right, 3460 + 10*resonator_delta + resonator_delta2, 11.3);
  r3 = res3.movement_filter(left, 3320 + 10*resonator_delta3, 2.1);
  r4 = res4.movement_filter(right, 4280 + 10*resonator_delta3 + resonator_delta4, 1.1);
  r5 = res5.movement_filter(left, 5420 + 10*resonator_delta3 - resonator_delta2, 6.1);
  r6 = res6.movement_filter(right, 5510 - 10*resonator_delta - resonator_delta3 - resonator_delta4, 5.1);
  out_left = r1 + r3 + r5 - r4;
  out_right = r2 + r4 + r6 - r3;
);

function quick_ellip(x)
local()
instance(y, 
         s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16,
         )
global()
(
  // Elliptical filter at 0.25
  y = 0.03974403712835188 * x + s1;
  s1 = 0.11443117839583584 * x - -1.2209793606380654 * y + s2;
  s2 = 0.4102732984609602 * x - 6.918940386446262 * y + s3;
  s3 = 0.8255281436307241 * x - -7.438409047076798 * y + s4;
  s4 = 1.6689828207164152 * x - 20.47654014058037 * y + s5;
  s5 = 2.5256753272317622 * x - -19.21733444638215 * y + s6;
  s6 = 3.6193770241123127 * x - 33.69411950162771 * y + s7;
  s7 = 4.250403515943048 * x - -27.235417392156258 * y + s8;
  s8 = 4.641846929462009 * x - 33.46680351213294 * y + s9;
  s9 = 4.25040351594302 * x - -22.8021725145997 * y + s10;
  s10 = 3.6193770241123016 * x - 20.29444701618275 * y + s11;
  s11 = 2.525675327231766 * x - -11.231790923026374 * y + s12;
  s12 = 1.6689828207164181 * x - 7.173357397659418 * y + s13;
  s13 = 0.8255281436307251 * x - -2.9956603900306376 * y + s14;
  s14 = 0.41027329846095995 * x - 1.2866484319363045 * y + s15;
  s15 = 0.11443117839583594 * x - -0.3305293493933626 * y + s16;
  s16 = 0.0397440371283519 * x - 0.07745428581611816 * y;
  
  y
);

function init_cheap_rm_am(shift, offset)
instance(t, dt, sin_1, sin_2, osc_coeff, half_offset)
global(srate)
local(piblock, w)
(
  half_offset = 0.5 * offset;
  piblock = 200 * $pi;
  dt = 2.0 * $pi * shift / srate;
  (t > piblock) ? t -= piblock;
  
  w = dt;
  osc_coeff = 2.0 * cos(w);
  t += dt;
  sin_1 = - cos(- w + t);
  sin_2 = - cos(- 2.0 * w + t);
  t -= dt;
);

function eval_cheap_rm_am(x)
instance(st, t, dt, osc_coeff, sin_1, sin_2, half_offset)
global()
local(mul)
(
  t += dt;
  
  st = osc_coeff * sin_1 - sin_2;
  sin_2 = sin_1;
  sin_1 = st;

  mul = 1.0 - half_offset;
  0.25 * x * (st * (1.0 - half_offset) + half_offset);
);


function init_cheapest_freq_shifter(shift)
instance(osc_coeff_t1, osc_coeff_t2,
         cos_t1_1, cos_t1_2, sin_t1_1, sin_t1_2,
         cos_t2_1, cos_t2_2, sin_t2_1, sin_t2_2,
         t1,  t2, dt1, dt2)
local(ip, piblock, w)
global(srate)
(
  piblock = 200 * $pi;
  //dt1 = 2.0 * $pi * 0.251;  // oscillating at srate / 4
  dt1 = 2.0 * $pi * 0.25;  // oscillating at srate / 4
  dt2 = dt1 + 2.0 * $pi * shift / srate;
  (t1 > piblock) ? t1 -= piblock;
  (t2 > piblock) ? t2 -= piblock;
  
  w = dt1;
  osc_coeff_t1 = 2.0 * cos(w);
  t1 += dt1;
  cos_t1_1 = sin(- w + t1);
  cos_t1_2 = sin(- 2.0*w + t1);
  sin_t1_1 = - cos(- w + t1);
  sin_t1_2 = - cos(- 2.0*w + t1);
  t1 -= dt1;
  
  w = dt2;
  osc_coeff_t2 = 2.0 * cos(w);
  t2 += dt2;
  cos_t2_1 = sin(- w + t2);
  cos_t2_2 = sin(- 2.0 * w + t2);
  sin_t2_1 = - cos(- w + t2);
  sin_t2_2 = - cos(- 2.0 * w + t2);
  t2 -= dt2;
);


function eval_cheapest_freq_shifter(v0)
instance(
  osc_coeff_t1, osc_coeff_t2,
  l1, l2,
  dt1, dt2,
  t1, t2,
  cos_t1_1, cos_t1_2, sin_t1_1, sin_t1_2,
  cos_t2_1, cos_t2_2, sin_t2_1, sin_t2_2,
)
local(ct1, st1, ct2, st2)
global(ssl, ssr)
(
  t1 += dt1;
  t2 += dt2;
  
  ct1 = osc_coeff_t1 * cos_t1_1 - cos_t1_2;
  cos_t1_2 = cos_t1_1;
  cos_t1_1 = ct1;
  
  ct2 = osc_coeff_t2 * cos_t2_1 - cos_t2_2;
  cos_t2_2 = cos_t2_1;
  cos_t2_1 = ct2;
  
  st1 = osc_coeff_t1 * sin_t1_1 - sin_t1_2;
  sin_t1_2 = sin_t1_1;
  sin_t1_1 = st1;
  
  st2 = osc_coeff_t2 * sin_t2_1 - sin_t2_2;
  sin_t2_2 = sin_t2_1;
  sin_t2_1 = st2;
  
  l1.quick_ellip(v0 * ct1) * ct2 + l2.quick_ellip(v0 * st1) * st2;
);

function calc_smooth_coeff(cutoff)
instance()
global(srate)
local(g)
( 
  g = tan($pi * cutoff / srate);
  g /(1 + g)
);

smooth_coeff = calc_smooth_coeff(1000.0 / 25.0);

function smooth(target)
global(smooth_coeff)
local(y, v)
instance(s)
(
  v = smooth_coeff * (target - s);
  y = v + s;
  s = y + v;
  y
);

function _init_spreader_buffer(freemem, in_buffer_size, window_in)
instance(buf, p0, p2, buffer_size, half_buffer, window)
global()
local()
(
  buffer_size = in_buffer_size;
  half_buffer = in_buffer_size / 2;
  window = window_in;
  p0 = 0;
  p2 = floor(rand() * (buffer_size - 1));
  buf = freemem;
  
  buf + buffer_size
);

function spreader_update_parameters(spread_slider, mix)
local(detune_fade, detuned_gain, spread)
global()
instance(
  <?i=0; loop(12, printf("shifter%d, ", i); i += 1;)?>
  dry_gain, total_gain, spread_gain,
)
(
  // Wrangle input parameters
  detune_fade = min(10.0 * spread_slider, 1.0);
  detuned_gain = (mix >= 100.0) ? 1.0 : 0.01 * mix;
  dry_gain = (mix <= 100.0) ? 1.0 : (detune_fade < 1.0) ? max(0.5 * (1.0 - detune_fade), (200.0 - mix) / 100.0) : (200.0 - mix) / 100.0;
  spread_gain = detuned_gain * detune_fade;
  total_gain = (spread_gain == 0.0) ? 1.0 : (1.41 / (1.0 + 2.4494897427831780981972840747059 * spread_gain));
  spread = 0.5 * spread_slider * spread_slider;
  
  // Set individual pitch shifter pitches
  shifter0.out_delta = pow(0.893, spread);
  shifter1.out_delta = pow(0.939, spread);
  shifter2.out_delta = pow(0.98, spread);
  shifter3.out_delta = pow(1.02, spread);
  shifter4.out_delta = pow(1.064, spread);
  shifter5.out_delta = pow(1.11, spread);
  
  shifter6.out_delta = pow(1.0 / 0.893, spread);
  shifter7.out_delta = pow(1.0 / 0.939, spread);
  shifter8.out_delta = pow(1.0 / 0.98, spread);
  shifter9.out_delta = pow(1.0 / 1.02, spread);
  shifter10.out_delta = pow(1.0 / 1.064, spread);
  shifter11.out_delta = pow(1.0 / 1.11, spread);
);

function _spreadshifter_tick(data)
instance(buf, p0, p2)
global()
local(p1i, p1f, p2i, x3, x3a, x3b, x4, x4a, x4b, fade34)
instance(out_delta, test, buffer_size, half_buffer, window)
(
  p0 -= 1;
  (p0 < 0) ? ( p0 += buffer_size; );
  buf[p0] = data;

  p2 -= out_delta;
  (p2 < 0) ? ( p2 += buffer_size; );

  p1i = floor(p2);
  p1f = p2 - p1i;
  x3a = buf[p1i];
  
  p1i += 1;
  (p1i >= buffer_size) ? ( p1i -= buffer_size; );

  x3b = buf[p1i];
  x3 = x3a + p1f * (x3b - x3a);
  
  p2i = (p1i + half_buffer);
  (p2i >= buffer_size) ? ( p2i -= buffer_size; );
  x4a = buf[p2i];
  
  p2i += 1;
  (p2i >= buffer_size) ? ( p2i -= buffer_size; );

  x4b = buf[p2i];
  x4 = x4a + p1f * (x4b - x4a);

  p2i = (p1i - p0);
  (p2i < 0) ? ( p2i += buffer_size; );
  
  fade34 = window[p2i];
  
  x4 + fade34 * (x3 - x4)
);

function init_spreader(freemem, _buffer_size)
local(i)
global()
instance(
  <?i=0; loop(12, printf("shifter%d, ", i); i += 1;)?>
  delayL, delayR, buffer_size, half_buffer, delay_ix, window, env_follower, env_follower2,
)
(
  buffer_size = _buffer_size;
  half_buffer = _buffer_size / 2;
  freemem = (window = freemem) + buffer_size;
  i = 0;
  loop(buffer_size,
    window[i] = 0.5 - 0.5 * cos(2.0 * $PI * i / buffer_size);
    i += 1;
  );

  freemem = (delayL = freemem) + buffer_size;
  freemem = (delayR = freemem) + buffer_size;
  
  delay_ix = 0;
  
  <?
    i = 0;
    loop(12,
      printf("freemem = shifter%d._init_spreader_buffer(freemem, buffer_size, window);", i);
      i += 1;
    );
  ?>
  
  freemem
);

function spreader_tick(inL, inR)
global()
local(delayed_in, total_out, avg, side)
instance(
  window,
  buffer_size, half_buffer,
  delayL, delayR, delay_ix, read_ix, read_ix2, outL, outR,
  <?i=0; loop(12, printf("shifter%d, ", i); i += 1;)?>
  dry_gain, total_gain, spread_gain,
  follower_state, zero_time, smooth_total_gain, smooth_total_gain.smooth,
)
(
  // Delay the main signal
  delayL[delay_ix] = inL;
  delayR[delay_ix] = inR;
  delay_ix += 1;
  (delay_ix >= buffer_size) ? delay_ix -= buffer_size;
  read_ix = delay_ix - half_buffer;
  (read_ix < 0) ? ( read_ix += buffer_size; );
  
  // Process the chorus
  outL = outR = 0;
  <?i = 0; loop(6, printf("outL += shifter%d._spreadshifter_tick(inL);", i); i += 1; );?>
  <?i = 6; loop(6, printf("outR += shifter%d._spreadshifter_tick(inR);", i); i += 1; );?>
  
  smooth_total_gain = smooth_total_gain.smooth(total_gain);

  outL = (dry_gain * delayL[read_ix] + outL * spread_gain) * smooth_total_gain;
  outR = (dry_gain * delayR[read_ix] + outR * spread_gain) * smooth_total_gain;
);

function retro_degrade(x, amt)
instance(hold, count, lp, target_count, lamt, q, iq, a)
local(sr, bits, y)
global(srate)
(
  (amt != lamt) ? (
    lamt = amt;  

    bits = 16 - amt*10;
    q = pow(2, bits);
    iq = 1 / q;

    sr = 18000 - amt*12000;
    target_count = srate/sr;
    a = 1 - exp(-2*$pi*(8000-amt*7000) / srate);
  );

  count <= 0 ? (
    count += target_count;
    hold = x;
  ) : count -= 1;

  y = floor(hold*q + .5) * iq;

  
  lp += (y - lp)*a;

  lp
);

function bitcrush(x, amt)
instance(count, lp, lamt, q, iq, a)
local(bits, y)
global(srate)
(
  (amt != lamt) ? (
    lamt = amt;
    
    bits = 16 - amt*12;
    q = pow(2, bits);
    iq = 1 / q;
    
    a = 1 - exp(-2*$pi*(22050-amt*12000) / srate);
  );
  
  y = floor(x*q + .5) * iq;
  lp += (y - lp) * a;

  lp
);

