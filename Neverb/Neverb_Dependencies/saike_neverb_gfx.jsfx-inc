@init

function make_font_atlas(dest)
local(dim_w, dim_h)
global(gfx_dest)
instance(font)
(
  dim_w = 224;
  dim_h = 78;
  gfx_setimgdim(dest, dim_w, dim_h);

  gfx_dest = dest;
  gfx_blit(12, 1, 0, 0, 0, dim_w, dim_h, 0, 0, dim_w, dim_h);

  gfx_muladdrect(
      0, 0, dim_w, dim_h,
      this.c1.r, this.c1.g, this.c1.b, 1,
      0, 0, 0, 0
  );
  font = dest;

  gfx_dest = -1;
);

function txt_blit(font, str, x, y)
local(ix, row, c_char, src_x, src_y, x_start, xc, yc, old_dest)
global(gfx_dest, gfx_x, gfx_a, gfx_mode)
(
  ix = 0;
  xc = x;
  yc = y;
  
  // W = 40 for coz
  
  x_start = x;
  loop(strlen(str),
    c_char = str_getchar(str, ix, 'cu');
    (c_char == 10) ? (
      yc += 5;
      xc = x_start;
    ) : (
      c_char -= 16 * 2;
      row = floor(c_char / 16);
      src_y = 13 * row;
      src_x = 14 * (c_char - row * 16);
      gfx_a = 1.0;
      gfx_blit(font, 1, 0, src_x, src_y, 14, 13, xc, yc, 14, 13, 0, 0); 
      gfx_a = 0.5;
      gfx_blit(font, 1, 0, src_x + 1, src_y, 14, 13, xc, yc, 14, 13, 0, 0); 
      xc += 7;
    );
    ix += 1;
  );
  
  gfx_x = xc;
);

function init_slider(_me, _slider_idx, _min, _max, _mapping, _default)
local()
global()
instance(me, slider_idx, min_value, max_value, mapping, default)
(
  slider_idx = _slider_idx;
  me = _me;
  min_value = _min;
  max_value = _max;
  mapping = _mapping;
  default = _default;
  
);

function set_position(_x, _y, _w, _h)
local()
global()
instance(x, y, w, h)
(
  x = _x;
  y = _y;
  w = _w;
  h = _h;
);

function panel_title(label)
local(tx)
global(gfx_a)
instance(hl1, hl2)
(
  gfx_set(this.c1.r, this.c1.g, this.c1.b, 0.3);
  
  tx = this.x - 1;
  gfx_rect(tx + 3, this.y + 2, 7, 7);
  gfx_circle(tx + 6, this.y + 5, 5 + rand(), 1);
  gfx_circle(tx + 6, this.y + 5, 3 + rand(), 1);
  gfx_circle(tx + 6, this.y + 5, 3 + rand(), 0);
  
  txt_blit(this.font, label, tx + 15, this.y);
  gfx_rect(tx, this.y + 18, this.w, 1);
  
  gfx_set(1, 1, 1, 0.1);
  gfx_rect(tx, this.y + 18, this.w + 40, 1);
  
  gfx_set(this.c1.r, this.c1.g, this.c1.b, 0.3);
  
  (!hl1) ? (
    hl1 = rand() * this.w;
    hl2 = rand() * this.w;
  );
  
  gfx_rect(tx + hl1, this.y + 18, this.w - hl1, 1);
  gfx_rect(tx, this.y + 18, this.w - hl2, 1);
  
  gfx_set(this.c1.r, this.c1.g, this.c1.b, 0.12);
  gfx_rect(tx, this.y + 19, this.w - hl2, 1);
  gfx_rect(tx, this.y + 17, this.w - hl2, 1);
  
  gfx_set(1, 1, 1, 0.3);
  gfx_circle(tx + 8, this.y + 3, rand(), 1);
  
  this.ry = this.y + 27;
);

function panel_edge(y_height, x_width, topshort, extra_top)
global(gfx_a)
local(tx_base, y_height, x_width)
(
  tx_base = this.x - 10;

  gfx_set(this.c1.r, this.c1.g, this.c1.b, 0.65);
  gfx_line(this.x + 1, this.y - 10, this.x + x_width - topshort, this.y - 10, 0);
  gfx_line(tx_base, this.y, this.x, this.y - 10, 0);
  gfx_line(tx_base, this.y + y_height + 1, this.x, this.y + 10 + y_height + 1, 0);
  gfx_line(this.x + 1, this.y + 10 + y_height + 1, this.x + x_width, this.y + 10 + y_height + 1, 0);

  topshort ? (
    gfx_line(this.x + x_width - topshort + 10 + 1, this.y, this.x + x_width - topshort + 1, this.y - 10, 0);
    
    extra_top ? ( 
      gfx_line(this.x + x_width - topshort + 10 + 2, this.y + 1, this.x + x_width - topshort + 10 + 1 + extra_top, this.y + 1, 0);
      
      gfx_a = 0.8;
      gfx_line(this.x + x_width - topshort + 10 + 1 + 3, this.y - 2, this.x + x_width - topshort + 1 + 5, this.y - 10, 0);
      gfx_a = 0.5;
      gfx_line(this.x + x_width - topshort + 10 + 1 + 7, this.y - 2, this.x + x_width - topshort + 1 + 9, this.y - 10, 0);
      gfx_a = 0.3;
      gfx_line(this.x + x_width - topshort + 10 + 1 + 11, this.y - 2, this.x + x_width - topshort + 1 + 13, this.y - 10, 0);
      gfx_set(1, 1, 1, 0.1);
      gfx_line(this.x + x_width - topshort + 10 + 1 + 15, this.y - 2, this.x + x_width - topshort + 1 + 17, this.y - 10, 0);
    );
    //gfx_set(1, 1, 1, 0.1);
    //gfx_line(this.x + x_width - topshort + 10 + 2, this.y + 1, this.x + x_width - topshort + 10 + 1 + extra_top, this.y + 1, 0);
  );
  
  gfx_set(1, 1, 1, 0.1);
  gfx_line(tx_base, this.y + 1, tx_base, this.y + y_height, 0);
  
  gfx_set(this.c1.r, this.c1.g, this.c1.b, 0.45);
  gfx_line(this.x, this.y - 10 - 1, this.x + x_width - topshort, this.y - 10 - 1, 0);
  //gfx_line(this.x + x_width + 1, this.y - 10 - 1, this.x + x_width + 1, this.y + y_height + 10 + 1);
  gfx_line(tx_base - 1, this.y, this.x - 1, this.y - 10, 0);
  gfx_line(tx_base - 1, this.y + 1, tx_base - 1, this.y + y_height, 0);
  gfx_line(tx_base - 1, this.y + y_height + 1, this.x - 1, this.y + 10 + y_height + 1, 0);
  gfx_line(this.x, this.y + 10 + y_height + 2, this.x + x_width, this.y + 11 + y_height + 1, 0);
  
  topshort ? (
    gfx_line(this.x + x_width - topshort + 10 + 2, this.y, this.x + x_width - topshort + 2, this.y - 10, 0);
  );
);

function draw_slider(label, value)
local(yc, xpip, ypip, pip_w, change)
instance(
  x, y, w, h,
  val,
  over_bar, over,
  _t, _dt,
  me,
  slider_idx,
  min_value, max_value, mapping,
)
global(rel_mouse_x, rel_mouse_y, last_cap, mouse_cap, global_cap, rel_mouse_dx, rel_mouse_dy, gfx_a, slider_changed)
(
  // Derive position from panel?
  (w == 0 && h == 0 && this..w != 0 && this..h != 0) ? (
    (this..ry == 0) ? this..ry = this..y;
    x = this..x;
    y = this..ry;
    w = this..w;
    h = this..h;
    
    this..ry += 30;
  );

  change = 0;
  slider_idx ? (
    (mapping == 0) ? (
      // Linear
      val = (slider(slider_idx) - min_value) / (max_value - min_value);
    ) : (
      // Log
      val = (log(slider(slider_idx)) - log(min_value)) / (log(max_value) - log(min_value));
    );
  );
  
  pip_w = 5;

  yc = y;
  gfx_set(this..c1.r, this..c1.g, this..c1.b, 1.0);
  txt_blit(this..font, label, x, y);
  
  yc = y + 14;
  xpip = x + w * val - 3;

  over = (rel_mouse_x >= xpip - 1) && (rel_mouse_x <= xpip + pip_w + 2) && (rel_mouse_y >= yc - 2) && (rel_mouse_y <= yc + h + 4);
  over_bar = (rel_mouse_x >= x) && (rel_mouse_x <= x + w) && (rel_mouse_y >= yc - 2) && (rel_mouse_y <= yc + h + 4);
  (mouse_cap & 1) ? (
    (global_cap == me) ? (
      _t = 1;
      val = max(min(val + rel_mouse_dx / w, 1.0), 0.0);
      change = 1;
    ) : ( over && (global_cap == 0) && (last_cap & 1 == 0) ? (
        global_cap = me;
      ) : ( over_bar & ( last_cap & 1 == 0 ) && (global_cap == 0)) ? (
        val = max(min((rel_mouse_x - x) / w, 1.0), 0.0);
        change = 1;
        global_cap = me;
      );
    );
  ) : (
    // Release
    (global_cap == me) ? (
      global_cap = 0;
    );
  );
  
  xpip = x + w * val - 3;

  gfx_set(this..c3.r, this..c3.g, this..c3.b, 1.0);
  gfx_rect(x + floor(w * val), yc, w - floor(w * val), h);

  gfx_set(this..c1.r, this..c1.g, this..c1.b, 1.0);
  gfx_rect(x, yc, w * val, h);
  
  gfx_a = 0.1;
  gfx_rect(x, yc, w, 1);
  gfx_rect(x, yc + h, w, 1);
  
  gfx_set(this..c3.r, this..c3.g, this..c3.b, 0.2);
  gfx_rect(xpip, yc - 1, pip_w, h + 2);
  
  gfx_set(this..c1.r, this..c1.g, this..c1.b, 1.0);
  gfx_rect(xpip + 1, yc - 1, pip_w, h + 2);
  
  over ? (
    gfx_set(1, 1.0, 1, 0.1 * _t);
    gfx_rect(xpip - 1, yc - 3, pip_w + 4, h + 6);
    gfx_set(1, 1.0, 1, 0.2 * _t);
    gfx_rect(xpip, yc - 2, pip_w + 2, h + 4);
    _t += _dt;
    (_t > 1) || (_t < 0) ? (_dt = - _dt);
  ) : (
    _t = 0;
    _dt = 0.1;
  );
  
  gfx_set(1, 1, 1, 0.3);
  gfx_circle(xpip + 4, yc-1, 0.5, 1);
  
  gfx_set(this..c1.r, this..c1.g, this..c1.b, 1.0);
  txt_blit(this..font, value, x + w + 5, yc - 0.5 * h);
  
  change ? (
    slider_idx ? (
      (mapping == 0) ? (
        // Linear
        slider(slider_idx) = val * (max_value - min_value) + min_value;
      ) : (
        // Log
        slider(slider_idx) = exp((log(max_value) - log(min_value)) * val + log(min_value));
      );
    );
    slider_changed = 1;
  );
);

function draw_toggle(label, value, w, offset, height, want_edge)
local(val, xc, height)
instance(
  slider_idx,
  x, y,
  over,
)
global(rel_mouse_x, rel_mouse_y, last_cap, mouse_cap, global_cap, slider_changed)
(
  val = slider(slider_idx);
  
  // Derive position from panel?
  (x == 0 && this..x != 0) ? (
    (this..ry == 0) ? this..ry = this..y;
    x = this..x;
    y = this..ry;
  );
  
  xc = x + offset;
  over = (rel_mouse_x >= xc) && (rel_mouse_x <= xc + w) && (rel_mouse_y >= y - 2) && (rel_mouse_y <= y + height + 4);
  (val == value) ? gfx_set(this..c1.r, this..c1.g, this..c1.b, 0.48 + 0.2 * over) : gfx_set(this..c3.r, this..c3.g, this..c3.b, 0.48 + 0.2 * over);
  
  gfx_rect(xc, y, w, height);
  gfx_set(this..c2.r, this..c2.g, this..c2.b, 1);
  want_edge ? gfx_rect(xc, y, w, height, 0);
  
  gfx_set(this..c1.r, this..c1.g, this..c1.b, 1.0);
  txt_blit(this..font, label, xc + 0.5 * (w - strlen(label) * 8), y + 0.5 * (height - 12));

  gfx_set(this..c1.r, this..c1.g, this..c1.b, 1.0);
  //gfx_rect(x, yc, w * val, h);
  
  (over && (last_cap == 0) && (mouse_cap == 1) && (global_cap == 0)) ? (
    (value != val) ? (
      slider_changed = 1;
      slider(slider_idx) = value;
    );
  )
);

