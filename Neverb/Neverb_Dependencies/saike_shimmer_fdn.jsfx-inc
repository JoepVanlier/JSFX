@init
function init_verb(freemem)
instance(
  d0, d1, d2, d3, d4, d5, d6, d7,
  p,

  lp0, lp1, lp2, lp3, lp4, lp5, lp6, lp7,
  shim_buf, half_shim_size, shim_mask,

  osc_x0, osc_x1, osc_x2, osc_x3,
  osc_y0, osc_y1, osc_y2, osc_y3,

  osc_c0, osc_c1, osc_c2, osc_c3,
  osc_s0, osc_s1, osc_s2, osc_s3,

  mod0, mod1, mod2, mod3,

  len0, len1, len2, len3, len4, len5, len6, len7,

  gl0, gl1, gl2, gl3, gl4, gl5, gl6, gl7,
  gh0, gh1, gh2, gh3, gh4, gh5, gh6, gh7,
  
  gln0, gln1, gln2, gln3, gln4, gln5, gln6, gln7,
  ghn0, ghn1, ghn2, ghn3, ghn4, ghn5, ghn6, ghn7,

  norm,

  lp_a,

  mod_depth,
  mod_rate,
  width,

  freeze_amount,
  freeze_target,
  freeze_time,

  out_l,
  out_r
)
local(buffer_size)
globals()
(
  buffer_size = 65536;
  half_shim_size = 2048;
  shim_mask = half_shim_size + half_shim_size - 1;
  freemem = (d0 = freemem) + buffer_size;
  freemem = (d1 = freemem) + buffer_size;
  freemem = (d2 = freemem) + buffer_size;
  freemem = (d3 = freemem) + buffer_size;
  freemem = (d4 = freemem) + buffer_size;
  freemem = (d5 = freemem) + buffer_size;
  freemem = (d6 = freemem) + buffer_size;
  freemem = (d7 = freemem) + buffer_size;
  freemem = (shim_buf = freemem) + half_shim_size + half_shim_size;

  p = 0;

  lp0 = 0;
  lp1 = 0;
  lp2 = 0;
  lp3 = 0;
  lp4 = 0;
  lp5 = 0;
  lp6 = 0;
  lp7 = 0;

  osc_x0 = 1;
  osc_x1 = 1;
  osc_x2 = 1;
  osc_x3 = 1;

  osc_y0 = 0;
  osc_y1 = 0;
  osc_y2 = 0;
  osc_y3 = 0;

  osc_c0 = 1;
  osc_c1 = 1;
  osc_c2 = 1;
  osc_c3 = 1;

  osc_s0 = 0;
  osc_s1 = 0;
  osc_s2 = 0;
  osc_s3 = 0;

  mod0 = 1;
  mod1 = 1;
  mod2 = 1;
  mod3 = 1;

  len0 = 0;
  len1 = 0;
  len2 = 0;
  len3 = 0;
  len4 = 0;
  len5 = 0;
  len6 = 0;
  len7 = 0;

  gl0 = 0;
  gl1 = 0;
  gl2 = 0;
  gl3 = 0;
  gl4 = 0;
  gl5 = 0;
  gl6 = 0;
  gl7 = 0;

  gh0 = 0;
  gh1 = 0;
  gh2 = 0;
  gh3 = 0;
  gh4 = 0;
  gh5 = 0;
  gh6 = 0;
  gh7 = 0;

  gln0 = 0;
  gln1 = 0;
  gln2 = 0;
  gln3 = 0;
  gln4 = 0;
  gln5 = 0;
  gln6 = 0;
  gln7 = 0;

  ghn0 = 0;
  ghn1 = 0;
  ghn2 = 0;
  ghn3 = 0;
  ghn4 = 0;
  ghn5 = 0;
  ghn6 = 0;
  ghn7 = 0;

  norm = 0.353553390593;

  lp_a = 0;

  mod_depth = 0;
  mod_rate = 0;
  width = 0.85;

  freeze_amount = 0;
  freeze_target = 0;
  freeze_time = 0.05;

  out_l = 0;
  out_r = 0;

  freemem
);


function clear_verb()
instance(
  d0,d1,d2,d3,d4,d5,d6,d7,
  p,

  lp0,lp1,lp2,lp3,
  lp4,lp5,lp6,lp7,

  osc_x0,osc_x1,osc_x2,osc_x3,
  osc_y0,osc_y1,osc_y2,osc_y3,

  freeze_amount,

  out_l,out_r
)
globals()
local(i)
(
  i = 0;

  loop(65536,
    d0[i] = 0;
    d1[i] = 0;
    d2[i] = 0;
    d3[i] = 0;
    d4[i] = 0;
    d5[i] = 0;
    d6[i] = 0;
    d7[i] = 0;

    i += 1;
  );

  p = 0;

  lp0 = 0;
  lp1 = 0;
  lp2 = 0;
  lp3 = 0;
  lp4 = 0;
  lp5 = 0;
  lp6 = 0;
  lp7 = 0;

  osc_x0 = 1;
  osc_x1 = 1;
  osc_x2 = 1;
  osc_x3 = 1;

  osc_y0 = 0;
  osc_y1 = 0;
  osc_y2 = 0;
  osc_y3 = 0;

  freeze_amount = 0;

  out_l = 0;
  out_r = 0;
);

function set_verb(low_decay_time, high_decay_time, crossover, depth, rate, stereo_width, shimmer_amnt, shim_lp)
instance(
  len0,len1,len2,len3,
  len4,len5,len6,len7,

  gl0,gl1,gl2,gl3,
  gl4,gl5,gl6,gl7,

  gh0,gh1,gh2,gh3,
  gh4,gh5,gh6,gh7,

  gln0,gln1,gln2,gln3,
  gln4,gln5,gln6,gln7,

  ghn0,ghn1,ghn2,ghn3,
  ghn4,ghn5,ghn6,ghn7,

  norm,

  lp_a,
  
  lp_shim,
  shimmer_amount,

  mod_depth,
  mod_rate,
  width,

  osc_c0,osc_c1,osc_c2,osc_c3,
  osc_s0,osc_s1,osc_s2,osc_s3
)
globals(srate)
local(
  r0,r1,
  w0,w1,w2,w3
)
(
  len0 = 0.02971*srate;
  len1 = 0.03317*srate;
  len2 = 0.03791*srate;
  len3 = 0.04273*srate;

  len4 = 0.04811*srate;
  len5 = 0.05393*srate;
  len6 = 0.06061*srate;
  len7 = 0.06731*srate;

  len0 = min(len0,65534);
  len1 = min(len1,65534);
  len2 = min(len2,65534);
  len3 = min(len3,65534);
  len4 = min(len4,65534);
  len5 = min(len5,65534);
  len6 = min(len6,65534);
  len7 = min(len7,65534);

  lp_a = exp(-2*$pi*crossover/srate);
  
  lp_shim = exp(-2*$pi*shim_lp/srate);

  r0 = max(low_decay_time,0.05);
  r1 = max(high_decay_time,0.05);

  gl0 = exp(-6.907755278982137*len0/srate/r0);
  gl1 = exp(-6.907755278982137*len1/srate/r0);
  gl2 = exp(-6.907755278982137*len2/srate/r0);
  gl3 = exp(-6.907755278982137*len3/srate/r0);
  gl4 = exp(-6.907755278982137*len4/srate/r0);
  gl5 = exp(-6.907755278982137*len5/srate/r0);
  gl6 = exp(-6.907755278982137*len6/srate/r0);
  gl7 = exp(-6.907755278982137*len7/srate/r0);

  gh0 = exp(-6.907755278982137*len0/srate/r1);
  gh1 = exp(-6.907755278982137*len1/srate/r1);
  gh2 = exp(-6.907755278982137*len2/srate/r1);
  gh3 = exp(-6.907755278982137*len3/srate/r1);
  gh4 = exp(-6.907755278982137*len4/srate/r1);
  gh5 = exp(-6.907755278982137*len5/srate/r1);
  gh6 = exp(-6.907755278982137*len6/srate/r1);
  gh7 = exp(-6.907755278982137*len7/srate/r1);

  gln0 = gl0*norm;
  gln1 = gl1*norm;
  gln2 = gl2*norm;
  gln3 = gl3*norm;
  gln4 = gl4*norm;
  gln5 = gl5*norm;
  gln6 = gl6*norm;
  gln7 = gl7*norm;

  ghn0 = gh0*norm;
  ghn1 = gh1*norm;
  ghn2 = gh2*norm;
  ghn3 = gh3*norm;
  ghn4 = gh4*norm;
  ghn5 = gh5*norm;
  ghn6 = gh6*norm;
  ghn7 = gh7*norm;

  mod_depth = depth;
  mod_rate = rate;
  width = stereo_width;

  shimmer_amount = shimmer_amnt;

  w0 = 2*$pi*rate*0.71/srate;
  w1 = 2*$pi*rate*0.83/srate;
  w2 = 2*$pi*rate*0.97/srate;
  w3 = 2*$pi*rate*1.13/srate;

  osc_c0 = cos(w0);
  osc_c1 = cos(w1);
  osc_c2 = cos(w2);
  osc_c3 = cos(w3);

  osc_s0 = sin(w0);
  osc_s1 = sin(w1);
  osc_s2 = sin(w2);
  osc_s3 = sin(w3);
);


function process_mod()
instance(
  osc_x0,osc_x1,osc_x2,osc_x3,
  osc_y0,osc_y1,osc_y2,osc_y3,

  osc_c0,osc_c1,osc_c2,osc_c3,
  osc_s0,osc_s1,osc_s2,osc_s3,

  mod0,mod1,mod2,mod3
)
globals()
local(nx,ny)
(
  nx = osc_c0*osc_x0 - osc_s0*osc_y0;
  ny = osc_s0*osc_x0 + osc_c0*osc_y0;

  osc_x0 = nx;
  osc_y0 = ny;
  mod0 = nx;

  nx = osc_c1*osc_x1 - osc_s1*osc_y1;
  ny = osc_s1*osc_x1 + osc_c1*osc_y1;

  osc_x1 = nx;
  osc_y1 = ny;
  mod1 = nx;

  nx = osc_c2*osc_x2 - osc_s2*osc_y2;
  ny = osc_s2*osc_x2 + osc_c2*osc_y2;

  osc_x2 = nx;
  osc_y2 = ny;
  mod2 = nx;

  nx = osc_c3*osc_x3 - osc_s3*osc_y3;
  ny = osc_s3*osc_x3 + osc_c3*osc_y3;

  osc_x3 = nx;
  osc_y3 = ny;
  mod3 = nx;
);


function read_delay(buffer, ptr, delay)
globals()
local(r, i, f, im1, ip1, ip2, a, b, c, d)
(
  r = ptr - delay + 65536;

  i = r|0;
  f = r-i;

  i = i & 65535;

  im1 = (i-1) & 65535;
  ip1 = (i+1) & 65535;
  ip2 = (i+2) & 65535;

  a = buffer[im1];
  b = buffer[i];
  c = buffer[ip1];
  d = buffer[ip2];

  b + 0.5*f*(c-a + f*(2*a-5*b+4*c-d + f*(3*(b-c)+d-a)))
);

function read_delay(buffer, ptr, delay)
globals()
local(r, i, f, im1, ip1, a,b,c)
(
  r = ptr - delay + 65536;
  i = r|0;
  f = r-i;

  i = i & 65535;
  im1 = (i-1) & 65535;
  ip1 = (i+1) & 65535;

  a = buffer[im1];
  b = buffer[i];
  c = buffer[ip1];

  b + 0.5*f*(c-a + f*(a-2*b+c))
);

function process(in_l, in_r)
instance(
  d0,d1,d2,d3,d4,d5,d6,d7,
  p,
  lp_shim,
  lp0,lp1,lp2,lp3,lp4,lp5,lp6,lp7,
  lp_shim_state,
  len0,len1,len2,len3,
  len4,len5,len6,len7,
  gln0,gln1,gln2,gln3,
  gln4,gln5,gln6,gln7,
  ghn0,ghn1,ghn2,ghn3,
  ghn4,ghn5,ghn6,ghn7,
  norm,
  lp_a,
  mod0,mod1,mod2,mod3,
  mod_depth,
  freeze_amount,
  freeze_target,
  freeze_time,
  width,
  out_l, out_r
  
  // shimmer state
  shimmer_amount,
  shim_buf, ptr_s, shim_offset, shim_mask, half_shim_size,
  force_inject,
)
globals(srate, nonlinear)
local(
  y0,y1,y2,y3,y4,y5,y6,y7,
  lo0,lo1,lo2,lo3,
  lo4,lo5,lo6,lo7,
  hi0,hi1,hi2,hi3,
  hi4,hi5,hi6,hi7,
  g0,g1,g2,g3,
  g4,g5,g6,g7,
  m0,m1,m2,m3,
  m4,m5,m6,m7,
  z0,z1,z2,z3,
  z4,z5,z6,z7,
  inj0,inj1,inj2,inj3,
  inj4,inj5,inj6,inj7,
  h0,h1,h2,h3,
  h4,h5,h6,h7,
  sum,
  md,
  fade,
  mid,
  side,
  sat, scale,
  inj_amount,
  shim_phase, shim_gain, shim_val,
)
(
  freeze_amount +=
    (freeze_target-freeze_amount) *
    (1-exp(-1/(max(freeze_time,0.001)*srate)));

  freeze_amount = min(max(freeze_amount,0),1);

  this.process_mod();

  md = mod_depth*0.001*srate; //*(1-freeze_amount);
  y0 = read_delay(d0, p, len0 + md*mod0);
  y1 = read_delay(d1, p, len1 + md*mod1);
  y2 = read_delay(d2, p, len2 + md*mod2);
  y3 = read_delay(d3, p, len3 + md*mod3);
  y4 = read_delay(d4, p, len4 - md*mod0);
  y5 = read_delay(d5, p, len5 - md*mod1);
  y6 = read_delay(d6, p, len6 - md*mod2);
  y7 = read_delay(d7, p, len7 - md*mod3);

  lp0 += (y0 - lp0) * (1.0 - lp_a);
  lp1 += (y1 - lp1) * (1.0 - lp_a);
  lp2 += (y2 - lp2) * (1.0 - lp_a);
  lp3 += (y3 - lp3) * (1.0 - lp_a);
  lp4 += (y4 - lp4) * (1.0 - lp_a);
  lp5 += (y5 - lp5) * (1.0 - lp_a);
  lp6 += (y6 - lp6) * (1.0 - lp_a);
  lp7 += (y7 - lp7) * (1.0 - lp_a);

  lo0 = lp0;
  lo1 = lp1;
  lo2 = lp2;
  lo3 = lp3;
  lo4 = lp4;
  lo5 = lp5;
  lo6 = lp6;
  lo7 = lp7;

  hi0 = y0-lo0;
  hi1 = y1-lo1;
  hi2 = y2-lo2;
  hi3 = y3-lo3;
  hi4 = y4-lo4;
  hi5 = y5-lo5;
  hi6 = y6-lo6;
  hi7 = y7-lo7;

  fade = freeze_amount;
  g0 = lo0*(gln0 + fade*(norm-gln0)) + hi0*(ghn0 + fade*(norm-ghn0));
  g1 = lo1*(gln1 + fade*(norm-gln1)) + hi1*(ghn1 + fade*(norm-ghn1));
  g2 = lo2*(gln2 + fade*(norm-gln2)) + hi2*(ghn2 + fade*(norm-ghn2));
  g3 = lo3*(gln3 + fade*(norm-gln3)) + hi3*(ghn3 + fade*(norm-ghn3));
  g4 = lo4*(gln4 + fade*(norm-gln4)) + hi4*(ghn4 + fade*(norm-ghn4));
  g5 = lo5*(gln5 + fade*(norm-gln5)) + hi5*(ghn5 + fade*(norm-ghn5));
  g6 = lo6*(gln6 + fade*(norm-gln6)) + hi6*(ghn6 + fade*(norm-ghn6));
  g7 = lo7*(gln7 + fade*(norm-gln7)) + hi7*(ghn7 + fade*(norm-ghn7));

  h0 = g0+g1+g2+g3+g4+g5+g6+g7;
  h1 = g0-g1+g2-g3+g4-g5+g6-g7;
  h2 = g0+g1-g2-g3+g4+g5-g6-g7;
  h3 = g0-g1-g2+g3+g4-g5-g6+g7;
  h4 = g0+g1+g2+g3-g4-g5-g6-g7;
  h5 = g0-g1+g2-g3-g4+g5-g6+g7;
  h6 = g0+g1-g2-g3-g4-g5+g6+g7;
  h7 = g0-g1-g2+g3-g4+g5+g6-g7;

  nonlinear ? h0 *= (1 + 0.1 * exp(-abs(h0)*10) * (1 - abs(h0)*10));

  shim_offset = (shim_offset - 1) & shim_mask;
  shim_phase = 1.0 - abs(shim_offset - half_shim_size) / half_shim_size;
  shim_gain = shim_phase * shim_phase * (3.0 - 2.0 * shim_phase);
  shim_val = shim_buf[(ptr_s - shim_offset) & shim_mask] * shim_gain + shim_buf[(ptr_s - shim_offset - half_shim_size) & shim_mask] * (1 - shim_gain);
  
  shim_val = lp_shim_state += (shim_val - lp_shim_state) * (1.0 - lp_shim);
  
  in_l -= shimmer_amount * shim_val;
  in_r -= shimmer_amount * shim_val;

  inj0 = norm*(in_l + in_r);
  inj1 = norm*(in_l - in_r);
  inj2 = -inj1;
  inj3 = -inj0;

  inj4 = inj0;
  inj5 = inj1;
  inj6 = inj2;
  inj7 = inj3;

  inj_amount = 1 - fade;
  force_inject ? inj_amount = 1;
  z0 = h0 + inj0 * inj_amount;
  z1 = h1 + inj1 * inj_amount;
  z2 = h2 + inj2 * inj_amount;
  z3 = h3 + inj3 * inj_amount;
  z4 = h4 + inj4 * inj_amount;
  z5 = h5 + inj5 * inj_amount;
  z6 = h6 + inj6 * inj_amount;
  z7 = h7 + inj7 * inj_amount;

  out_l = (y0+y1+y2+y3-y4-y5-y6-y7);
  out_r = (y0+y1-y2-y3+y4+y5-y6-y7);
  out_l *= norm;
  out_r *= norm;

  mid = 0.5 * (out_l + out_r);
  side = 0.5 * (out_l - out_r);

  out_l = mid + side*width;
  out_r = mid - side*width;

  d0[p] = z0;
  d1[p] = z1;
  d2[p] = z2;
  d3[p] = z3;

  d4[p] = z4;
  d5[p] = z5;
  d6[p] = z6;
  d7[p] = z7;
  
  p = (p + 1) & 65535;
  
  shim_buf[ptr_s] = mid;
  ptr_s = (ptr_s + 1) & shim_mask;
);

