last_mouse_y = mouse_y;

@block
lpg.init_lpg_rates();

@sample
slider_changed ? (
  update_settings();
  slider_changed = 0;
);

function run_lpg(left, right)
global(lpg_level)
instance(smooth_lpg, out_left, out_right)
local(smooth_lpg_iterp)
(
  smooth_lpg = 0.001 * max(0.95, lpg_level) + 0.999 * smooth_lpg;
  
  (smooth_lpg < 0.9999) ? (
    this.lpg_update(left, right);
    smooth_lpg_iterp = (smooth_lpg - 0.95) * 20;
    out_left = this.lpg_LP1(left) * (1.0 - smooth_lpg_iterp) + left * smooth_lpg_iterp;
    out_right = this.lpg_LP2(right) * (1.0 - smooth_lpg_iterp) + right * smooth_lpg_iterp;
  ) : (
    out_left = left;
    out_right = right;
  );
);


(lpg_wiring == 2) ? (
  lpg.run_lpg(spl0, spl1);
  spl0 = lpg.out_left;
  spl1 = lpg.out_right;
);

tank_input_left = spl0 + fb_l;
tank_input_right = spl1 + fb_r;

(lpg_wiring == 0) ? (
  lpg.run_lpg(tank_input_left, tank_input_right);
  tank_input_left = lpg.out_left;
  tank_input_right = lpg.out_right;
);

verb.process(tank_input_left, tank_input_right);
fb_l = fb_r = 0;

((noise_level > 0) || (drive > 0)) ? (
  verb.out_l = l_compander.compander_compress(verb.out_l);
  verb.out_r = r_compander.compander_compress(verb.out_r);
  
  noise_type == 0 ? (
    r1 = rand();
    r1 = r1 * r1 * r1 - 0.25;
    r2 = rand();
    r2 = r2 * r2 * r2 - 0.25;
    
    r1 = 0.5 * (r1 + lr1);
    lr1 = r1;
    
    r2 = 0.5 * (r2 + lr2);
    lr2 = r2;
  ) : (noise_type == 1) ? (
    r1 = 0.25 * rand() - 0.125;
    b0 = 0.99765 * b0 + r1 * 0.0990460;
    b1 = 0.96300 * b1 + r1 * 0.2965164;
    b2 = 0.57000 * b2 + r1 * 1.0526913;
    r1 = b0 + b1 + b2 + r1 * 0.1848;
  
    r2 = 0.25 * rand() - 0.125;
    c0 = 0.99765 * c0 + r2 * 0.0990460;
    c1 = 0.96300 * c1 + r2 * 0.2965164;
    c2 = 0.57000 * c2 + r2 * 1.0526913;
    r2 = c0 + c1 + c2 + r2 * 0.1848;
  ) : (noise_type == 2) ? (
    r1 = c1.lp_fuzz(0.999);
    r2 = c2.lp_fuzz(0.999);
  ) : (noise_type == 3) ? (
    r1 = c1.crackle(70, 0.008) + c2.crackle(4, 0.055);
    r2 = c3.crackle(70, 0.008) + c4.crackle(4, 0.055);
  ) : (noise_type == 4) ? (
    r1 = c1.granckle(15, 0.028, 3) + c2.granckle(8, 0.035, 4);
    r2 = c3.granckle(15, 0.028, 3) + c4.granckle(8, 0.035, 4);
    fb_l += 0.01 * r1;
    fb_r += 0.01 * r2;
  );
  
  bias_const = bias * drive;
  verb.out_l += noise_level * r1 + bias_const;
  verb.out_r += noise_level * r2 + bias_const;
  
  verb.out_l = verb.out_l - drive * verb.out_l * verb.out_l * verb.out_l;
  verb.out_r = verb.out_r - drive * verb.out_r * verb.out_r * verb.out_r;
  bias_const = bias_const - drive * bias_const * bias_const * bias_const;
  verb.out_l -= bias_const;
  verb.out_r -= bias_const;
  
  verb.out_l = l_compander.compander_expand(verb.out_l);
  verb.out_r = r_compander.compander_expand(verb.out_r);
);

drift_noise = noise.slow_noise_sample();
verb.out_l = pitch_drift_left.pitch_drift_sample(verb.out_l, pitch_instability, drift_noise);
verb.out_r = pitch_drift_right.pitch_drift_sample(verb.out_r, pitch_instability, drift_noise);


(lpg_wiring == 1) ? (
  lpg.run_lpg(verb.out_l, verb.out_r);
  verb.out_l = lpg.out_left;
  verb.out_r = lpg.out_right;
);

spl0 = spl0 * (1 - drywet) + verb.out_l * drywet;
spl1 = spl1 * (1 - drywet) + verb.out_r * drywet;

(lpg_wiring == 3) ? (
  lpg.run_lpg(spl0, spl1);
  spl0 = lpg.out_left;
  spl1 = lpg.out_right;
);

