function power_arc(x, y, h, t)
local(i, n, yy, yy2, xx, xx2)
(
  n = 30;

  i = 0;
  loop(n,

    i / n <= t ? (
      yy  = y + h * i / n;
      yy2 = y + h * (i + 1) / n;

      xx  = x + (rand(1) * 2 - 1) * 4;
      xx2 = x + (rand(1) * 2 - 1) * 4;

      gfx_set(0.6, 0.8, 1, 0.3);
      gfx_line(xx, yy, xx2, yy2);

      gfx_set(1, 0.9, 1, 1);
      gfx_line(xx, yy, xx2, yy2);
    );

    i += 1;
  );
);

function particle_line(particle_mem, x, y, h, n_particles, block_new, particle_pow)
local(ix, _x, _y, _life)
global(particle_mem, scaling)
(
  ix = 0;
  loop(n_particles,
    (particle_mem[ix] <= 0 && !block_new) ? (
      particle_mem[ix] = 20 * rand();
      particle_mem[ix + 1] = x;
      particle_mem[ix + 2] = y + rand() * h;
    ) : (
      particle_mem[ix] -= 1;
      particle_mem[ix + 1] += (rand() - 0.5) * particle_pow;
      particle_mem[ix + 2] += (rand() - 0.5) * particle_pow;
      
      _x = particle_mem[ix + 1];
      _y = particle_mem[ix + 2];
      _life = min(1.0, particle_mem[ix] * 0.3);
      gfx_set(1, 0.6, 1.5, 0.4 * _life);
      gfx_rect(scaling * (_x - 1), scaling * (_y - 1), 3 * scaling, 3 * scaling);
      gfx_set(1, 1, 1, _life);
      gfx_rect(scaling * _x, scaling * _y, scaling, scaling);
    );
    
    ix += 3;
  );
);

function core_line(x, y, h, w)
global(scaling)
local()
(
  (w > 0) ? (
    gfx_set(1, 0.6, 1, 0.4);
    gfx_rect((x - w) * scaling, y * scaling, (2 * w + 1) * scaling, h * scaling);
    gfx_set(1, 0.8, 1, 1);
    gfx_rect((x - w + 1) * scaling, y * scaling, (2 * w - 1) * scaling, h * scaling);
  );
);

gfx_mode = 1;


function emitter(mem, x, y, h)
global()
instance(t)
local(num, frac, block_new)
(
  t < 70 ? (
    block_new = 0;
    num = min(20, t);
    
    frac = t < 50 ? 1 - (t - 44) / 50 : (t - 50) / 5;
    frac = 1.8 * max(0, 1 - frac * frac);
    core_line(x, y, h, frac);
  ) : (
    block_new = 1;
  );
  particle_line(mem, x, y, h, num, block_new, 1.0 + frac);
  t += 1;
  t > 5000 ? t = 0;
);


spire1.emitter(particles, 662, 0, 140);
spire2.emitter(particles2, 629, 0, 134);
spire3.emitter(particles3, 647, 0, 70);


