slider20:lpg_wiring=0<0,3,1{Tank,Reverb,Full Input,Full Output}>-Low pass gate target

import saike_shimmer_fdn.jsfx-inc
import saike_nonlinear_fx.jsfx-inc
import saike_neverb_gfx.jsfx-inc

@init
function init_linearSVF_absolute(f0, res)
global(srate)
local(g)
instance(f0, ic1eq, ic2eq, k, a1, a2, a3)
(
  g = tan($pi * f0 / srate);
  k = 2 - 2*res;
      
  a1 = 1/(1+g*(g+k));
  a2 = g*a1;
  a3 = g*a2;
);

function lpg_LP1(v0)
global()
local(v1, v2, v3)
instance(ic1eq, ic2eq, a1, a2, a3)
(
  v3 = v0 - ic2eq;
  v1 = a1 * ic1eq + a2 * v3;
  v2 = ic2eq + a2 * ic1eq + a3*v3;
  ic1eq = 2*v1 - ic1eq;
  ic2eq = 2*v2 - ic2eq;    
  
  v2
);

function lpg_LP2(v0)
global()
local(v1, v2, v3)
instance(ic1eq2, ic2eq2, a1, a2, a3)
(
  v3 = v0 - ic2eq2;
  v1 = a1 * ic1eq2 + a2 * v3;
  v2 = ic2eq2 + a2 * ic1eq2 + a3*v3;
  ic1eq2 = 2*v1 - ic1eq2;
  ic2eq2 = 2*v2 - ic2eq2;    
  
  v2
);

function lpg_sat_func(lpg, input_gain)
local(t)
global()
(
  t = (0.573144 + 20.2149 * lpg*lpg*lpg*lpg) * input_gain;

  2.0 * (0.185304 * (1.0 - exp(- t*t)) - 0.00307613)
);

function init_lpg_rates()
global(srate)
instance(k_atk, k_decay)
(
  k_atk = 1000 / 9.22 / srate;
  k_decay = 1000 / 110.666667 / srate;
);

function lpg_update(spl0, spl1)
global(lpg_level)
local(cur, gate)
instance(c_sample, k_decay, k_atk, state, gate_freq)
(
  cur = max(abs(spl0), abs(spl1));
  
  state += state < cur ? k_atk * (cur - state) : k_decay * (cur - state);
  
  (c_sample % 8 == 0) ? (
    gate = min(lpg_sat_func(lpg_level, state), 1.0);
    
    gate_freq = max(50, 22050 * gate);
    this.init_linearSVF_absolute(gate_freq, 0);
  );
  
  c_sample += 1;
);

