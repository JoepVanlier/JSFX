function blit_sprite(x, y, scaling, sprite, index)
global()
(
  gfx_blit(8, scaling, 0, 8 * index, 8 * sprite, 8, 8, x, y);
);

//bird.draw_bird(1110, 190);

function draw_sprite(x, y, sprite, max_anim, speed, proba)
instance(index)
global(scaling)
(
  blit_sprite(x * scaling, y * scaling, scaling, sprite, index | 0);
  
  (index > 0) ? (
    index += speed;
    index > max_anim ? index = 0;
  ) : (
    (rand() < proba) ? ( index = speed );
  );
);

function draw_mosquito(x, y, diff)
local()
global(x_offset, y_offset, scaling)
instance(xc, yc)
(
  xc == 0 ? xc = x;
  yc == 0 ? yc = y;
  xc += diff * (rand() - 0.5) + 0.01 * (x - xc);
  yc += diff * (rand() - 0.5) + 0.01 * (y - yc);
  x = xc | 0;
  y = yc | 0;
  gfx_rect(scaling * x, scaling * y, 2, 2);
);

function draw_flying_bird(x, y, diff, spd)
local()
global(x_offset, y_offset, blit_scale)
instance(xc, yc, xt, yt, new_pos)
(
  new_pos -= 1;
  
  (new_pos < 0) ? (
    xt = x + (rand() - 0.5) * diff;
    yt = y + (rand() - 0.5) * diff;
    new_pos = 20 + 40 * rand();
  );
  
  xc == 0 ? ( xc = xt; yc = yt; );
  
  xc += 0.1 * (xt - xc);
  yc += 0.1 * (yt - yc);
  
  x = xc | 0;
  y = yc | 0;
  
  this.draw_sprite(x, y, 3, 5, spd, 1.0);
);


function mouse_run(x, y, w, h)
local()
instance(dx, dy, cx, cy, nx, ny)
global(scaling)
(
  (cx == 0) ? (
    cx = x;
    cy = y;
    nx = x + rand() * w;
    ny = y + rand() * h;
  );
  
  (rand() < 0.05) ? (
    nx = x + rand() * w;
    ny = y + rand() * h;
  );
  dx = nx - cx;
  dy = ny - cy;
  
  cx += 0.1 * dx;
  cy += 0.1 * dy;
  
  (abs(dx) + abs(dy) < 0.3) ? (
    gfx_rect(cx, cy - 1, 1, 1);
  );
  
  gfx_rect(scaling * (cx | 0), scaling * (cy | 0), 4, 2);
);


