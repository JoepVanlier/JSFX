slider9:stereo_width=1.0<0,1,0.001>-Stereo width

slider10:nonlinear=1<0,1,{Off,On}>-Feedback nonlinearity
slider11:noise_level=0.0171<0,0.1,0.0001>-Compander noise
slider12:drive=0.0075<0,0.025,0.0001>-Tube drive
slider13:bias=50<0,100,0.01>-Tube bias
slider14:noise_type=0<0,4,1>-Noise type
slider15:shimmer_amount=0<0,0.3,0.0001>-Shimmer amount
slider16:shimmer_lp_freq=1800<50,20000,10:log>-Shimmer lowpass
slider17:pitch_instability=4<0,8,.0001>-Depth [ms]
slider18:pitch_slowness=500<200,1000,.1:log>-slowness [ms]

//slider19:transient_chop=24.0<0, 24, 0.01>Transient remover
