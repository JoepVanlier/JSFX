function init_slow_noise(interval)
instance(noise_dt)
local()
global(srate)
(
  noise_dt = 1.0 / (srate * interval / 1000);
);

function slow_noise_sample()
instance(timeleft, d0, d1, d2, d3, w_noise, p_noise, noise_dt)
global()
local(t, t2, a0, a1, a2, a3)
(
  timeleft <= 0 ? (
    d3 = d2;
    d2 = d1;
    d1 = d0;
    d0 = 2.0 * (rand()-0.5);
    d0 *= d0 * d0;
    
    timeleft = timeleft + 1.0;
  );
  
  // Cubic interpolation
  t = 1.0 - timeleft;
  t2 = t * t;
  a0 = d0 - d1 - d3 + d2;
  a1 = d3 - d2 - a0;
  a2 = d1 - d3;
  a3 = d2;
  
  timeleft -= noise_dt;
  
  0.666 * (a0*t*t2+a1*t2+a2*t+a3);   // 0.666 ensures noise stays between -1 and 1
);

function pitch_drift_init(freemem)
local()
global()
instance(buffer)
(
  (buffer = freemem) + 4096
);

function pitch_drift_sample(sample, pitch_instability, noise)
globals(srate)
local(r, i, f, im1, ip1, ip2, a, b, c, d, read_loc, delay)
instance(buffer, write_loc)
(
  delay = 0.001 * srate * (pitch_instability * noise + 8);
  
  buffer[write_loc] = sample;
  write_loc = (write_loc + 1) & 4095;

  read_loc = write_loc - delay;
  read_loc < 0 ? read_loc += 4096;
  i = read_loc|0;
  f = read_loc - i;
  
  im1 = (i-1) & 4095;
  ip1 = (i+1) & 4095;
  ip2 = (i+2) & 4095;

  a = buffer[im1];
  b = buffer[i];
  c = buffer[ip1];
  d = buffer[ip2];

  b + 0.5*f*(c-a + f*(2*a-5*b+4*c-d + f*(3*(b-c)+d-a)))
);


noise.init_slow_noise(pitch_slowness);
noise2.init_slow_noise(pitch_slowness);

freemem = 0;

freemem = verb.init_verb(freemem);
freemem = pitch_drift_left.pitch_drift_init(freemem);
freemem = pitch_drift_right.pitch_drift_init(freemem);
freemem = (particles = freemem) + 90;
freemem = (particles2 = freemem) + 90;
freemem = (particles3 = freemem) + 90;
function update_settings()
(
  verb.set_verb(low_decay_time, high_decay_time, crossover, mod_depth, mod_rate, stereo_width, shimmer_amount, shimmer_lp_freq);
  verb.freeze_target = freeze;
  verb.freeze_time = freeze_time;
  noise.init_slow_noise(pitch_slowness);
  noise2.init_slow_noise(pitch_slowness);
);

update_settings();

verb.clear_verb();

